{
	file.3CA1F6C961E490AE.title: "Starforge · Quest Book"
	quest.57CE687B27C482B3.title: "Mechanical Age"
	quest.57CE687B27C482B3.quest_desc: [
		"The team masters engineering assembly and basic machines. Synced with the progression map - no manual completion needed."
	]
	quest.57CE687B27C482B3.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.30B185E865902CFB.title: "Electric Age"
	quest.30B185E865902CFB.quest_desc: [
		"Power and circuits enter the production system. Synced with the progression map - no manual completion needed."
	]
	quest.30B185E865902CFB.quest_subtitle: "Suggested stage: Electrical Age"
	quest.5CBFEC3F42242B50.title: "Information Age"
	quest.5CBFEC3F42242B50.quest_desc: [
		"Digital networks unify storage and crafting. Synced with the progression map - no manual completion needed."
	]
	quest.5CBFEC3F42242B50.quest_subtitle: "Suggested stage: Information Age"
	quest.016079F40895BC4A.title: "Heavy Industry Age"
	quest.016079F40895BC4A.quest_desc: [
		"Heavy industry and auto-turrets come online. Synced with the progression map - no manual completion needed."
	]
	quest.016079F40895BC4A.quest_subtitle: "Suggested stage: Heavy Industry Age"
	quest.245AA3038DD177F7.title: "Atomic Age"
	quest.245AA3038DD177F7.quest_desc: [
		"Nuclear power joins the grid - technology peaks. Synced with the progression map - no manual completion needed."
	]
	quest.245AA3038DD177F7.quest_subtitle: "Suggested stage: Atomic Age"
	quest.3B95DA0212939412.title: "Space Age"
	quest.3B95DA0212939412.quest_desc: [
		"Rockets leave orbit - civilization leaves Earth. Synced with the progression map - no manual completion needed."
	]
	quest.3B95DA0212939412.quest_subtitle: "Suggested stage: Space Age"
	quest.27746B580BF2533A.title: "Quantum Age"
	quest.27746B580BF2533A.quest_desc: [
		"Quantum tech breaks the distance limit. Synced with the progression map - no manual completion needed."
	]
	quest.27746B580BF2533A.quest_subtitle: "Suggested stage: Quantum Age"
	chapter.3417920818FE4D66.title: "Era Milestones"
	chapter.3417920818FE4D66.chapter_subtitle: [
		"A live record of the seven technology eras - synced with the ProgressiveStages map, no manual completion needed."
	]
	quest.0E79A6A14CA31F91.title: "Welcome to Starforge"
	quest.0E79A6A14CA31F91.quest_desc: [
		"This quest book is a manual and milestone map: stages advance by crafting evidence components, never by turning in quests. Every chapter stays available."
		""
		"{\"text\":\"» See the manual: Team Progression and Specialization\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"306787D7CF3A4AAE\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Team Progression and Specialization\"}}"
	]
	quest.0E79A6A14CA31F91.quest_subtitle: "Suggested stage: Survival Age"
	quest.0D1AC1E27C5540EB.title: "Your Team"
	quest.0D1AC1E27C5540EB.quest_desc: [
		"Manufacturing research is shared per team and synced when members join. Players can specialize freely; buying finished goods never grants crafting rights."
		""
		"{\"text\":\"» See the manual: Team Progression and Specialization\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"306787D7CF3A4AAE\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Team Progression and Specialization\"}}"
		"{\"text\":\"» See the manual: The Earth-Sufficient Route\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6B23A0DB3D268796\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Earth-Sufficient Route\"}}"
	]
	quest.0D1AC1E27C5540EB.quest_subtitle: "Suggested stage: Survival Age"
	quest.13CFB46ABD3B5830.title: "First Camp"
	quest.13CFB46ABD3B5830.quest_desc: [
		"Build shelter, a bed, storage, and starter fields. Lighting and fencing are the first layer of defense."
	]
	quest.13CFB46ABD3B5830.quest_subtitle: "Suggested stage: Survival Age"
	quest.2F3A025FCA06D48B.title: "The First Pot"
	quest.2F3A025FCA06D48B.quest_desc: [
		"Craft a Farmer's Delight cooking pot so the kitchen can serve the whole base. Farming and storage growth live in the Agriculture chapter."
		""
		"{\"text\":\"» See the manual: Kitchen Automation\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B1F9252FB11EAD5\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Kitchen Automation\"}}"
	]
	quest.2F3A025FCA06D48B.quest_subtitle: "Suggested stage: Survival Age"
	quest.4CD255DB2734A955.title: "Engineering Assembly"
	quest.4CD255DB2734A955.quest_desc: [
		"Craft an engineering assembly by hand to move the team into the Mechanical Age. Stage evidence always comes from crafting, never from pickups or submissions."
		""
		"{\"text\":\"» See the manual: The Storage Growth Path\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"453A61A0B4D9C159\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Storage Growth Path\"}}"
	]
	quest.4CD255DB2734A955.quest_subtitle: "Suggested stage: Survival Age"
	quest.6FD4163A437DB329.title: "Register the Base"
	quest.6FD4163A437DB329.quest_desc: [
		"Register your main base in the base status screen: threat, supply, oxygen, and power are tracked within its bounds. Re-register after relocating."
	]
	quest.6FD4163A437DB329.quest_subtitle: "Suggested stage: Survival Age"
	quest.4A5C4FDCC304869D.title: "Seven Routes"
	quest.4A5C4FDCC304869D.quest_desc: [
		"The book's seven chapters map to seven long-term routes — all visible, no required order. Start with what suits you; the rest can wait or go to teammates."
	]
	quest.4A5C4FDCC304869D.quest_subtitle: "Suggested stage: Survival Age"
	quest.04678E0F669135E0.title: "The Iron Kit"
	quest.04678E0F669135E0.quest_desc: [
		"An iron pickaxe, sword, and bucket: mining, defense, and water hauling in one kit."
	]
	quest.04678E0F669135E0.quest_subtitle: "Suggested stage: Survival Age"
	quest.13C6FDBBC0A6A1F8.title: "Open the Progression Map"
	quest.13C6FDBBC0A6A1F8.quest_desc: [
		"The button left of the inventory GUI opens the ProgressiveStages map: the era spine, capability branches and every unlock condition live there. The questbook only explains routes."
		""
		"{\"text\":\"» See the manual: Team Progression and Specialization\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"306787D7CF3A4AAE\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Team Progression and Specialization\"}}"
	]
	quest.13C6FDBBC0A6A1F8.quest_subtitle: "Suggested stage: Survival Age"
	chapter.55C7495156B62A20.title: "Getting Started"
	chapter.55C7495156B62A20.chapter_subtitle: [
		"Your first steps from campsite to first machine: the quest book, team progression, the kitchen, milestone components, and base registration."
	]
	quest.08529A1698B8AB8E.title: "Your First Industrial Power Supply"
	quest.08529A1698B8AB8E.quest_desc: [
		"Prepare a basic circuit, a generator, and safe wiring. Run one machine reliably before expanding the grid. Equipment is not submitted or consumed."
		""
		"{\"text\":\"» See the manual: Power Priority\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"08F61C4EED508F67\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Power Priority\"}}"
	]
	quest.08529A1698B8AB8E.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.2539374E4F2A6024.title: "Get More from Every Ore"
	quest.2539374E4F2A6024.quest_desc: [
		"Feed mined resources into industrial processing and collect primary products and byproducts separately. Check for blocked inputs and ensure dust is not reprocessed as raw ore."
	]
	quest.2539374E4F2A6024.quest_subtitle: "Suggested stage: Electrical Age"
	quest.43D15883966FA564.title: "Power for Large Industry"
	quest.43D15883966FA564.quest_desc: [
		"Plan the reactor, cooling, isolation, and backup power. Test shutdowns and failures before connecting essential production lines."
		""
		"{\"text\":\"» See the manual: Power Priority\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"08F61C4EED508F67\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Power Priority\"}}"
	]
	quest.43D15883966FA564.quest_subtitle: "Suggested stage: Atomic Age"
	quest.3046722B35FDD226.title: "Quantum Industry on Earth"
	quest.3046722B35FDD226.quest_desc: [
		"Refine your first iridium on Earth, then establish UU-Matter scanning and replication. Quantum control assemblies require neither alien resources nor boss drops."
	]
	quest.3046722B35FDD226.quest_subtitle: "Suggested stage: Quantum Age"
	quest.13C7D62337B55213.title: "Wiring Up"
	quest.13C7D62337B55213.quest_desc: [
		"Hook the generator to a batbox with copper cable: power must be stored and delivered, not just made. Keep runs short for now."
		""
		"{\"text\":\"» See the manual: Power Priority\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"08F61C4EED508F67\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Power Priority\"}}"
		"{\"text\":\"» See the manual: One Network: FastPipes\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E8B4E397AC0FBCA\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"One Network: FastPipes\"}}"
	]
	quest.13C7D62337B55213.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.661C32BC2172153E.title: "First Electric Machines"
	quest.661C32BC2172153E.quest_desc: [
		"An electric furnace and compressor come online: smelting and forming stop burning coal."
	]
	quest.661C32BC2172153E.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.74254B1A5ACF0303.title: "First Steel"
	quest.74254B1A5ACF0303.quest_desc: [
		"Coke oven to blast furnace: steel underpins rail, turrets, and heavy structures. Stand the line up early."
	]
	quest.74254B1A5ACF0303.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.5AA32800D1C581FB.title: "Oil Bootstrapping"
	quest.5AA32800D1C581FB.quest_desc: [
		"Pump crude oil through FastPipes fluid pipes into storage tanks. The first step of the unified oil chain: get the fluid home before worrying about refining."
		""
		"{\"text\":\"» See the manual: The Unified Oil Economy\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1932C9CEA2E264BB\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Unified Oil Economy\"}}"
	]
	quest.5AA32800D1C581FB.quest_subtitle: "Suggested stage: Electrical Age"
	quest.32189FD328AB1060.title: "Electronics Batch"
	quest.32189FD328AB1060.quest_desc: [
		"Stockpile circuit boards and electron tubes — every machine, signal, and production line downstream feeds on these."
	]
	quest.32189FD328AB1060.quest_subtitle: "Suggested stage: Electrical Age"
	quest.12BF8F4E036DE8B1.title: "Heavy Machinery Frames"
	quest.12BF8F4E036DE8B1.quest_desc: [
		"Heavy engineering blocks and the arc furnace: steel and electronics converge here, and output reaches heavy-industry scale."
	]
	quest.12BF8F4E036DE8B1.quest_subtitle: "Suggested stage: Heavy Industry Age"
	quest.45E40F3C3FF4ED9C.title: "Reactor Hall"
	quest.45E40F3C3FF4ED9C.quest_desc: [
		"Nuclear reactor, chambers, and containment plating — the hardware base of the power grid. Build the shell before worrying about the grid."
	]
	quest.45E40F3C3FF4ED9C.quest_subtitle: "Suggested stage: Atomic Age"
	chapter.6FCE566CEE4CE64E.title: "Industrial Engineering"
	chapter.6FCE566CEE4CE64E.chapter_subtitle: [
		"Supply power, circuits, and advanced materials to keep industry running."
	]
	quest.1E6E9ECA6921E56E.title: "From Chests to Production Lines"
	quest.1E6E9ECA6921E56E.quest_desc: [
		"Use drawers and versatile storage for bulk ore, ingots, parts, and crops, then connect machines with FastPipes item pipes and extractor attachments. Plan overflow handling and stop signals before increasing transport speed."
		""
		"{\"text\":\"» See the manual: The Storage Growth Path\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"453A61A0B4D9C159\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Storage Growth Path\"}}"
		"{\"text\":\"» See the manual: One Network: FastPipes\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E8B4E397AC0FBCA\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"One Network: FastPipes\"}}"
	]
	quest.1E6E9ECA6921E56E.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.4F47C604F5D375CC.title: "Start Your First Digital Warehouse"
	quest.4F47C604F5D375CC.quest_desc: [
		"Power an inscriber independently to make processors, then let the digital network take over existing physical warehouses through storage buses. Presses can be manufactured on Earth and meteorites are an optional shortcut; drawers and stockrooms keep their value."
		""
		"{\"text\":\"» See the manual: AE2 Cold Start\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"79F690776849AD03\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"AE2 Cold Start\"}}"
	]
	quest.4F47C604F5D375CC.quest_subtitle: "Suggested stage: Information Age"
	quest.401D4EAB9AB4A6E1.title: "Produce to Stock Targets"
	quest.401D4EAB9AB4A6E1.quest_desc: [
		"Aggregate physical inventory through a storage controller, then set restocking thresholds for circuits, ammunition, and food. Prioritize essential supplies and plan for full storage, power loss, and missing ingredients."
	]
	quest.401D4EAB9AB4A6E1.quest_subtitle: "Suggested stage: Information Age"
	quest.4B11C059543966A4.title: "The Munitions Supply Chain"
	quest.4B11C059543966A4.quest_desc: [
		"Factory → ammo depot → logistics trunk → frontline ammo box. Use stock thresholds so the logistics system refills boxes automatically; turrets and guards just keep firing."
		""
		"{\"text\":\"» See the manual: Auto-Turrets: Loading & Resupply\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2E55B63F9D911701\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Auto-Turrets: Loading & Resupply\"}}"
	]
	quest.4B11C059543966A4.quest_subtitle: "Suggested stage: Information Age"
	quest.4B4C77575CC4219A.title: "Connect Remote Bases"
	quest.4B4C77575CC4219A.quest_desc: [
		"Link powered, loaded networks with a quantum bridge and keep local supply buffers. A disconnected base should still sustain essential operations."
	]
	quest.4B4C77575CC4219A.quest_subtitle: "Suggested stage: Quantum Age"
	quest.1E674A8A5C906BBF.title: "Build a Freight Rail Network"
	quest.1E674A8A5C906BBF.quest_desc: [
		"Connect mines and the industrial base with freight trains: cargo carts haul bulk goods, tank carts carry fluids, and loaders handle both ends. Short-range in-base transport still belongs to pipes and conveyors."
		""
		"{\"text\":\"» See the manual: Rail Logistics\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4642427A4336C17F\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Rail Logistics\"}}"
	]
	quest.1E674A8A5C906BBF.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.3991787934E071A4.title: "Bring the Railway to the Spaceport"
	quest.3991787934E071A4.quest_desc: [
		"Run ore trains straight into the launch complex: trains feed sorting and storage, then fuel loading and rockets handle the interplanetary leg. Colony landing zones, mines, oxygen plants, and pads can use the same pattern."
		""
		"{\"text\":\"» See the manual: Spaceport Rail\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4BD992661353F0B8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Spaceport Rail\"}}"
	]
	quest.3991787934E071A4.quest_subtitle: "Suggested stage: Space Age"
	quest.55D5885078439343.title: "Warehouse Hookup"
	quest.55D5885078439343.quest_desc: [
		"Extractor attachments pull, item pipes haul: feed the loose production lines into unified storage over FastPipes so every crate has somewhere to go."
		""
		"{\"text\":\"» See the manual: The Storage Growth Path\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"453A61A0B4D9C159\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Storage Growth Path\"}}"
		"{\"text\":\"» See the manual: One Network: FastPipes\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E8B4E397AC0FBCA\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"One Network: FastPipes\"}}"
	]
	quest.55D5885078439343.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.0DB724B7A030812E.title: "Signals and Blocks"
	quest.0DB724B7A030812E.quest_desc: [
		"Signal circuits and block signals come online: trains run by section, and the trunk line stops rear-ending itself."
		""
		"{\"text\":\"» See the manual: Rail Logistics\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4642427A4336C17F\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Rail Logistics\"}}"
	]
	quest.0DB724B7A030812E.quest_subtitle: "Suggested stage: Electrical Age"
	quest.3FDA41ACF6A75A22.title: "The Network Goes Live"
	quest.3FDA41ACF6A75A22.quest_desc: [
		"Controller, energy cell, and storage buses — the network starts reading physical storage. Get a small grid stable before scaling automation."
		""
		"{\"text\":\"» See the manual: AE2 Cold Start\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"79F690776849AD03\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"AE2 Cold Start\"}}"
	]
	quest.3FDA41ACF6A75A22.quest_subtitle: "Suggested stage: Information Age"
	quest.0456D2DC6A3C47D0.title: "Autocrafting"
	quest.0456D2DC6A3C47D0.quest_desc: [
		"Crafting units, molecular assemblers, and pattern providers: the network can now build things, not just store them."
	]
	quest.0456D2DC6A3C47D0.quest_subtitle: "Suggested stage: Information Age"
	quest.7D9816358D597DD3.title: "Drawer Wall"
	quest.7D9816358D597DD3.quest_desc: [
		"A wall of drawers layered by compression: normal drawers for bulk, compacting drawers auto-collapse ingot/block/nugget tiers."
		""
		"{\"text\":\"» See the manual: Storage Tiers\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FBDC2FE9BA6964E\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Storage Tiers\"}}"
	]
	quest.7D9816358D597DD3.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.17E40D93D5F53AAE.title: "General Storage Network"
	quest.17E40D93D5F53AAE.quest_desc: [
		"A Sophisticated Storage controller links barrels into a searchable warehouse for everything drawers don't hold."
		""
		"{\"text\":\"» See the manual: Storage Tiers\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FBDC2FE9BA6964E\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Storage Tiers\"}}"
	]
	quest.17E40D93D5F53AAE.quest_subtitle: "Suggested stage: Electrical Age"
	quest.284763ACA7D3BC91.title: "Field Backpack"
	quest.284763ACA7D3BC91.quest_desc: [
		"Sophisticated Backpacks are field logistics: pickup upgrade auto-loads drops; magnet, furnace and stack upgrades fit the mission."
		""
		"{\"text\":\"» See the manual: Expedition Loadouts\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D8C96A7B6F83F18\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Expedition Loadouts\"}}"
	]
	quest.284763ACA7D3BC91.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.49FEF6A934F5A795.title: "Steam Power"
	quest.49FEF6A934F5A795.quest_desc: [
		"Railcraft boilers and turbines are dependable early power: fluid fireboxes burn fuel oil, HP boilers raise steam."
		""
		"{\"text\":\"» See the manual: Advanced Railcraft\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FB73CF25E88351B\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Advanced Railcraft\"}}"
	]
	quest.49FEF6A934F5A795.quest_subtitle: "Suggested stage: Electrical Age"
	quest.1736F25A60869410.title: "Automated (Un)loading"
	quest.1736F25A60869410.quest_desc: [
		"Advanced loaders match manifests by filter, fluid loaders take tank cars - no one babysits the platform."
		""
		"{\"text\":\"» See the manual: Advanced Railcraft\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FB73CF25E88351B\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Advanced Railcraft\"}}"
	]
	quest.1736F25A60869410.quest_subtitle: "Suggested stage: Heavy Industry Age"
	quest.45FDF56BACC668EF.title: "Signal Interlock"
	quest.45FDF56BACC668EF.quest_desc: [
		"Controller, receiver and token boxes wire block sections into interlocking: no token, no entry."
		""
		"{\"text\":\"» See the manual: Advanced Railcraft\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FB73CF25E88351B\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Advanced Railcraft\"}}"
	]
	quest.45FDF56BACC668EF.quest_subtitle: "Suggested stage: Electrical Age"
	quest.37063572DC618E0A.title: "Tunnel Bore"
	quest.37063572DC618E0A.quest_desc: [
		"A tunnel bore with a steel head and track packs cuts and lays line on its own. Keep a supply cart attached."
		""
		"{\"text\":\"» See the manual: Advanced Railcraft\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FB73CF25E88351B\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Advanced Railcraft\"}}"
	]
	quest.37063572DC618E0A.quest_subtitle: "Suggested stage: Heavy Industry Age"
	quest.449D3297E192B8CE.title: "High-speed Rail"
	quest.449D3297E192B8CE.quest_desc: [
		"High-speed track demands signals and buffers - slow for corners. Powered HSR lets locomotives self-charge."
		""
		"{\"text\":\"» See the manual: Advanced Railcraft\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FB73CF25E88351B\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Advanced Railcraft\"}}"
	]
	quest.449D3297E192B8CE.quest_subtitle: "Suggested stage: Heavy Industry Age"
	quest.1A9D2B725EB00DDE.title: "Starport Hub"
	quest.1A9D2B725EB00DDE.quest_desc: [
		"Tie the launch pad, warehouses and loading bays into one trunk line: fuel, oxygen and cargo ride through."
		""
		"{\"text\":\"» See the manual: Spaceport Rail\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4BD992661353F0B8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Spaceport Rail\"}}"
	]
	quest.1A9D2B725EB00DDE.quest_subtitle: "Suggested stage: Space Age"
	chapter.17B3058067D055B5.title: "Automation and Logistics"
	chapter.17B3058067D055B5.chapter_subtitle: [
		"Connect resources, machines, and demand so supplies arrive when needed."
	]
	quest.1752DF1046FD05B2.title: "Your First Defensive Line"
	quest.1752DF1046FD05B2.quest_desc: [
		"Start with lighting, terrain, and safe paths. Build outer and inner lines with room to retreat, patrol, resupply, and repair."
		""
		"{\"text\":\"» See the manual: Horde Sappers\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6AD45769D44A5F98\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Horde Sappers\"}}"
		"{\"text\":\"» See the manual: Layered Base Defense\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6D57B198ED6623C4\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Layered Base Defense\"}}"
	]
	quest.1752DF1046FD05B2.quest_subtitle: "Suggested stage: Survival Age"
	quest.6A40076FB5A60443.title: "Gunsmithing"
	quest.6A40076FB5A60443.quest_desc: [
		"The gun workbench and ammo table stand up — guard and player weapons go industrial instead of being scavenged."
		""
		"{\"text\":\"» See the manual: The Colony Armory\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"15C288AF8333C644\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Colony Armory\"}}"
		"{\"text\":\"» See the manual: TaCZ Addon: Gunsmith Assistant\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"009B2C59FE3D645E\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"TaCZ Addon: Gunsmith Assistant\"}}"
	]
	quest.6A40076FB5A60443.quest_subtitle: "Suggested stage: Electrical Age"
	quest.1AEA18147C0DBE26.title: "Armed Guards"
	quest.1AEA18147C0DBE26.quest_desc: [
		"Issue conventional guns (rifles, SMGs, shotguns) to village guards — they are your most flexible mobile infantry. Keep explosives and exotic weapons in player hands; guards must not level the base."
		""
		"{\"text\":\"» See the manual: Choosing Guard Weapons\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"725FD622502D6892\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Choosing Guard Weapons\"}}"
		"{\"text\":\"» See the manual: Colony Guards\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4C0A7C642219B0D2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Colony Guards\"}}"
	]
	quest.1AEA18147C0DBE26.quest_subtitle: "Suggested stage: Electrical Age"
	quest.2F8112B376410105.title: "Industrial Sentry Guns"
	quest.2F8112B376410105.quest_desc: [
		"Deploy IE sentry turrets (gun turret / chem turret): the industrial age’s early fixed defense. Check ammo, firing lanes, and friend lists — never concentrate all reserves at one post."
		""
		"{\"text\":\"» See the manual: Three-Layer Defense\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"482CA592DE6BAB84\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Three-Layer Defense\"}}"
	]
	quest.2F8112B376410105.quest_subtitle: "Suggested stage: Electrical Age"
	quest.605556FAD18F13D3.title: "The Ammo Line"
	quest.605556FAD18F13D3.quest_desc: [
		"Ammo boxes and casull rounds roll off the line. A turret is just furniture without ammunition — the magazines are the real rations."
		""
		"{\"text\":\"» See the manual: Ammunition Logistics\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4C15617E8C8DA7F9\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Ammunition Logistics\"}}"
	]
	quest.605556FAD18F13D3.quest_subtitle: "Suggested stage: Electrical Age"
	quest.0578B3D427AD63A7.title: "Frontline Ammo Boxes"
	quest.0578B3D427AD63A7.quest_desc: [
		"Turrets only eat last-mile logistics: place an ammo box beneath or beside the turret and let AE2 / FastPipes keep it filled. Turrets do not take ammo straight from pipes."
		""
		"{\"text\":\"» See the manual: Auto-Turrets: Loading & Resupply\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2E55B63F9D911701\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Auto-Turrets: Loading & Resupply\"}}"
	]
	quest.0578B3D427AD63A7.quest_subtitle: "Suggested stage: Information Age"
	quest.13E59D0117879820.title: "Automatic Turret"
	quest.13E59D0117879820.quest_desc: [
		"The TACZ turret takes on whatever TaCZ gun you load into it. Install the gun, verify targeting mode and friend recognition, then hook up its ammo box."
		""
		"{\"text\":\"» See the manual: Auto-Turrets: Loading & Resupply\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2E55B63F9D911701\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Auto-Turrets: Loading & Resupply\"}}"
	]
	quest.13E59D0117879820.quest_subtitle: "Suggested stage: Heavy Industry Age"
	quest.39599EDCD459B7B2.title: "EOS Arsenal"
	quest.39599EDCD459B7B2.quest_desc: [
		"EOS Dawn Goddess Lab weapons unlocked: gauss rifles, ELP plasma guns and exotic ordnance for high-intensity combat. More firepower, much pricier ammo logistics — make sure production can keep up first."
		""
		"{\"text\":\"» See the manual: EOS Dawn Goddess Lab Weapons\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"60BD0CCFC3034959\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"EOS Dawn Goddess Lab Weapons\"}}"
	]
	quest.39599EDCD459B7B2.quest_subtitle: "Suggested stage: Atomic Age"
	quest.43727C69AA43A83C.title: "Swarm Suppression"
	quest.43727C69AA43A83C.quest_desc: [
		"High-RPM and area-effect EOS weapons are built for Arachnids swarms and major hordes. Suppression is strong, but sustained fire burns through ammo stockpiles fast."
		""
		"{\"text\":\"» See the manual: EOS Dawn Goddess Lab Weapons\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"60BD0CCFC3034959\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"EOS Dawn Goddess Lab Weapons\"}}"
	]
	quest.43727C69AA43A83C.quest_subtitle: "Suggested stage: Atomic Age"
	quest.09D27335218273DA.title: "Expedition Firepower"
	quest.09D27335218273DA.quest_desc: [
		"Prepare heavy firepower and deep ammo reserves for off-world expeditions: high-threat alien targets and cut-off supply lines both lean on this layer."
		""
		"{\"text\":\"» See the manual: Expedition Ammunition Prep\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"76E5B544AD6A0494\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Expedition Ammunition Prep\"}}"
	]
	quest.09D27335218273DA.quest_subtitle: "Suggested stage: Space Age"
	quest.31583156C2BDAC96.title: "Hold the Base During a Supply Failure"
	quest.31583156C2BDAC96.quest_desc: [
		"Drill a power-grid or transport failure. Check that oxygen, basic firepower, and food reserves remain available, and record actual consumption during each defense."
		""
		"{\"text\":\"» See the manual: Colony Supply Chains\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"744853EABC0E1648\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Colony Supply Chains\"}}"
		"{\"text\":\"» See the manual: Layered Base Defense\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6D57B198ED6623C4\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Layered Base Defense\"}}"
	]
	quest.31583156C2BDAC96.quest_subtitle: "Suggested stage: Atomic Age"
	quest.5CF44E6653A66A00.title: "Armed Guard Drill"
	quest.5CF44E6653A66A00.quest_desc: [
		"Audit every guard's weapon, ammo and post, then run a full watch rotation."
		""
		"{\"text\":\"» See the manual: Choosing Guard Weapons\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"725FD622502D6892\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Choosing Guard Weapons\"}}"
	]
	quest.5CF44E6653A66A00.quest_subtitle: "Suggested stage: Electrical Age"
	quest.5F36C6B42FD75BA9.title: "Munitions Stress Test"
	quest.5F36C6B42FD75BA9.quest_desc: [
		"Simulate supply loss: halt auto-resupply for 30 minutes and confirm local ammo boxes last one horde."
		""
		"{\"text\":\"» See the manual: Auto-Turrets: Loading & Resupply\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2E55B63F9D911701\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Auto-Turrets: Loading & Resupply\"}}"
	]
	quest.5F36C6B42FD75BA9.quest_subtitle: "Suggested stage: Information Age"
	quest.771A802F55780549.title: "Live Turret Trial"
	quest.771A802F55780549.quest_desc: [
		"Let the turret net repel a raid uncrewed; log ammo burn and coverage gaps."
		""
		"{\"text\":\"» See the manual: Auto-Turrets: Loading & Resupply\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2E55B63F9D911701\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Auto-Turrets: Loading & Resupply\"}}"
	]
	quest.771A802F55780549.quest_subtitle: "Suggested stage: Heavy Industry Age"
	quest.6DD56A7E6F10A880.title: "EOS Weapon Challenge"
	quest.6DD56A7E6F10A880.quest_desc: [
		"Take a high-risk target down with EOS heavy weapons and prove the ammo line keeps pace."
		""
		"{\"text\":\"» See the manual: EOS Dawn Goddess Lab Weapons\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"60BD0CCFC3034959\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"EOS Dawn Goddess Lab Weapons\"}}"
	]
	quest.6DD56A7E6F10A880.quest_subtitle: "Suggested stage: Atomic Age"
	chapter.23F04414D2AFEB65.title: "Base Defense"
	chapter.23F04414D2AFEB65.chapter_subtitle: [
		"Plan defenses and firepower, then keep them supplied to protect industry and homes."
	]
	quest.061F44AAFD6FFC83.title: "Industrial Preparation for Launch"
	quest.061F44AAFD6FFC83.quest_desc: [
		"Produce aerospace materials and a control core on Earth. Prepare fuel, oxygen, food, and return reserves. Verify supplies before scheduling your first flight."
	]
	quest.061F44AAFD6FFC83.quest_subtitle: "Suggested stage: Atomic Age"
	quest.7FA3F49803108CD1.title: "From the Factory to the Moon"
	quest.7FA3F49803108CD1.quest_desc: [
		"Bring startup power, oxygen equipment, and building materials to establish a lunar outpost with a safe return plan. Alien mining improves efficiency but is not required for Earth technology."
		""
		"{\"text\":\"» See the manual: Space Utility Gear\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"344ED9F136392B5D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Space Utility Gear\"}}"
		"{\"text\":\"» See the manual: The Safe Station\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4B5A9C30A8FBCA52\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Safe Station\"}}"
	]
	quest.7FA3F49803108CD1.quest_subtitle: "Suggested stage: Space Age"
	quest.7FD9F6B5176631DF.title: "Build an Orbital Hub"
	quest.7FD9F6B5176631DF.quest_desc: [
		"Build a safe station for storage, research, and transfers. Enemies do not appear by default, but oxygen and power are still required. Special events only occur when explicitly enabled."
		""
		"{\"text\":\"» See the manual: The Safe Station\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4B5A9C30A8FBCA52\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Safe Station\"}}"
	]
	quest.7FD9F6B5176631DF.quest_subtitle: "Suggested stage: Space Age"
	quest.0E6767E1E6DA1ED6.title: "Make Colonies Self-Sufficient"
	quest.0E6767E1E6DA1ED6.quest_desc: [
		"Give each outpost local storage, power, greenhouses, housing, and a garrison line. Specialize by planetary strengths and account for transport and defense costs before expanding."
		""
		"{\"text\":\"» See the manual: Lightweight Colonies\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5D67189820FB07DC\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Lightweight Colonies\"}}"
		"{\"text\":\"» See the manual: Colony Residents\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6FBF02C8FB016AC6\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Colony Residents\"}}"
	]
	quest.0E6767E1E6DA1ED6.quest_subtitle: "Suggested stage: Space Age"
	quest.0AF6F16EA4174410.title: "Space Utility Gear"
	quest.0AF6F16EA4174410.quest_desc: [
		"Oxygen cans, fuel loaders, rocket sensors, and gravity normalizers smooth out daily spaceport work. Environmental enchantment books still cost planet-tier materials and never replace oxygen or fuel systems."
		""
		"{\"text\":\"» See the manual: Space Utility Gear\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"344ED9F136392B5D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Space Utility Gear\"}}"
	]
	quest.0AF6F16EA4174410.quest_subtitle: "Suggested stage: Space Age"
	quest.16E992F88F58E687.title: "Reach the Asteroid Belt"
	quest.16E992F88F58E687.quest_desc: [
		"The belt has no solid ground to land on: a missed approach can strand or destroy the rocket, oxygen is zero, and no rescue is coming. Pack a return plan and supplies; treat the first flight as a survey, not a mining run."
		""
		"{\"text\":\"» See the manual: Asteroid Belt Hazards\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2BFD78A0764A92FF\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Asteroid Belt Hazards\"}}"
	]
	quest.16E992F88F58E687.quest_subtitle: "Suggested stage: Space Age"
	quest.52A6CBDE7280FA89.title: "Asteroid Mining Operations"
	quest.52A6CBDE7280FA89.quest_desc: [
		"Floating ore rocks carry iron, copper, gold, and a little gemstone at far greater density than planetary veins. Plan anchor points, lighting, and recovery routes so high risk becomes steady output."
		""
		"{\"text\":\"» See the manual: Asteroid Belt Hazards\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2BFD78A0764A92FF\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Asteroid Belt Hazards\"}}"
	]
	quest.52A6CBDE7280FA89.quest_subtitle: "Suggested stage: Space Age"
	quest.125E01F71BB1770C.title: "Rocket Workshop"
	quest.125E01F71BB1770C.quest_desc: [
		"NASA workbench, launch pad, and fins in place — rocket assembly begins. Pick the pad site with clear sky overhead."
		""
		"{\"text\":\"» See the manual: Space Utility Gear\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"344ED9F136392B5D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Space Utility Gear\"}}"
	]
	quest.125E01F71BB1770C.quest_subtitle: "Suggested stage: Space Age"
	quest.31E14278C99F13AB.title: "Fuel Chain"
	quest.31E14278C99F13AB.quest_desc: [
		"The refinery makes fuel and the loader feeds the rocket — no more bucket runs. This chain is also the final leg of the oil economy."
		""
		"{\"text\":\"» See the manual: The Unified Oil Economy\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1932C9CEA2E264BB\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Unified Oil Economy\"}}"
	]
	quest.31E14278C99F13AB.quest_subtitle: "Suggested stage: Space Age"
	quest.56FE663A93DD6F1A.title: "Moonfall"
	quest.56FE663A93DD6F1A.quest_desc: [
		"Plant the first flag on the Moon — the first stop beyond orbit, and a proving ground for oxygen and return reserves."
	]
	quest.56FE663A93DD6F1A.quest_subtitle: "Suggested stage: Space Age"
	quest.3FDFA2A65CA97C91.title: "Mars Expedition"
	quest.3FDFA2A65CA97C91.quest_desc: [
		"Reach Mars: desh ore and a second permanent colony site. Pack redundant oxygen, fuel, and a return plan before leaving."
	]
	quest.3FDFA2A65CA97C91.quest_subtitle: "Suggested stage: Space Age"
	quest.04089907F6DAA567.title: "Life Support"
	quest.04089907F6DAA567.quest_desc: [
		"Oxygen loading, distribution, and water pumping online — the station goes from 'landable' to 'livable'. A prerequisite for colony growth."
		""
		"{\"text\":\"» See the manual: The Safe Station\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4B5A9C30A8FBCA52\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Safe Station\"}}"
	]
	quest.04089907F6DAA567.quest_subtitle: "Suggested stage: Space Age"
	quest.7EFD6B90AAB0B745.title: "Low-gravity Combat"
	quest.7EFD6B90AAB0B745.quest_desc: [
		"Low gravity changes recoil, jumps and falls. Fire live on a planet surface and note the difference."
		""
		"{\"text\":\"» See the manual: Low-g & Alien Combat\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"46C8EE9AF7A2DC7E\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Low-g & Alien Combat\"}}"
	]
	quest.7EFD6B90AAB0B745.quest_subtitle: "Suggested stage: Space Age"
	quest.01A8A31E7CBB6ACA.title: "Return Resupply"
	quest.01A8A31E7CBB6ACA.quest_desc: [
		"Every expedition keeps return fuel, oxygen and food untouched. Return reserve is hard payload, never spent."
		""
		"{\"text\":\"» See the manual: Expedition Loadouts\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D8C96A7B6F83F18\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Expedition Loadouts\"}}"
		"{\"text\":\"» See the manual: Space Utility Gear\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"344ED9F136392B5D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Space Utility Gear\"}}"
	]
	quest.01A8A31E7CBB6ACA.quest_subtitle: "Suggested stage: Space Age"
	quest.2297FE3FCEB77ECA.title: "Planetary Recon"
	quest.2297FE3FCEB77ECA.quest_desc: [
		"Every body differs in gravity, heat, radiation and loot. Run the recon checklist before unloading."
		""
		"{\"text\":\"» See the manual: Alien Structures & Archaeology\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"706640814E58980D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Alien Structures & Archaeology\"}}"
		"{\"text\":\"» See the manual: Ecological Survey\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BE0F716B792B7F8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Ecological Survey\"}}"
	]
	quest.2297FE3FCEB77ECA.quest_subtitle: "Suggested stage: Space Age"
	chapter.7A1F8F3DD46D426E.title: "Spaceflight and Colonization"
	chapter.7A1F8F3DD46D426E.chapter_subtitle: [
		"Plan flights, oxygen, and supplies to turn distant outposts into reliable production bases."
	]
	quest.5CFC818ECAF2A1E1.title: "Survey with a Purpose"
	quest.5CFC818ECAF2A1E1.quest_desc: [
		"Record ore sites, routes, terrain, and potential outposts. Surveys help engineers and builders choose locations without requiring combat."
	]
	quest.5CFC818ECAF2A1E1.quest_subtitle: "Suggested stage: Survival Age"
	quest.2E3803EB5B7C3AB1.title: "Turn Ruins into Industrial Shortcuts"
	quest.2E3803EB5B7C3AB1.quest_desc: [
		"Recover useful materials, presses, and blueprints. They save industrial investment, while equivalent essential functions retain deterministic manufacturing routes."
	]
	quest.2E3803EB5B7C3AB1.quest_subtitle: "Suggested stage: Information Age"
	quest.6B02183287572A0A.title: "Challenge a Dangerous Ruin"
	quest.6B02183287572A0A.quest_desc: [
		"Choose whether to challenge a ruin boss. Prepare supplies and an escape route for valuable materials or special modules. Victory does not unlock required technology."
	]
	quest.6B02183287572A0A.quest_subtitle: "Suggested stage: Space Age"
	quest.33F96CADFA9891F7.title: "Investigate Alien Anomalies"
	quest.33F96CADFA9891F7.quest_desc: [
		"Observe anomaly warnings before choosing to sample or withdraw. Process recovered materials through industrial and research facilities; keep unknown samples out of living quarters."
	]
	quest.33F96CADFA9891F7.quest_subtitle: "Suggested stage: Space Age"
	quest.17108BC68E5E17B5.title: "Survey Alien Structures"
	quest.17108BC68E5E17B5.quest_desc: [
		"Ruins and towers on the planets hold supplies — and spawners for native creatures. Loot scales with the planet, but no find replaces industrial manufacturing."
	]
	quest.17108BC68E5E17B5.quest_subtitle: "Suggested stage: Space Age"
	quest.5FB2C68FD35C744B.title: "Recover Alien Relic Curios"
	quest.5FB2C68FD35C744B.quest_desc: [
		"Artifacts are exploration-only rewards. Earth's ruins and campsites hold basic utility curios; Moon/Mars ruins hold survival and exploration aids; Venus/Mercury ruins hold combat and defensive curios; Glacio ruins and the Asteroid Belt hold the rarest relics. No curio replaces oxygen, space suits, or rocket tiers."
	]
	quest.5FB2C68FD35C744B.quest_subtitle: "Suggested stage: Space Age"
	quest.7B5BD275BEF97E3E.title: "Expedition Kit"
	quest.7B5BD275BEF97E3E.quest_desc: [
		"Compass, map, and torches — the explorer's three essentials. See the manual's Backpacks and Expedition Kits page for loadout upgrades."
		""
		"{\"text\":\"» See the manual: Backpacks and Expedition Kits\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"28C9F6D61C4E55C2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Backpacks and Expedition Kits\"}}"
	]
	quest.7B5BD275BEF97E3E.quest_subtitle: "Suggested stage: Survival Age"
	quest.0B6E927FD2CC7D1B.title: "Nether Recon"
	quest.0B6E927FD2CC7D1B.quest_desc: [
		"A quick trip through the portal: quartz, blaze rods, and shroomlight are all worth marking. Get in, look around, get out."
	]
	quest.0B6E927FD2CC7D1B.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.76B7ECD689453090.title: "Sky Stone Lab"
	quest.76B7ECD689453090.quest_desc: [
		"The charger wakes sky stone into fluix crystals — the raw lifeline of the digital network."
	]
	quest.76B7ECD689453090.quest_subtitle: "Suggested stage: Information Age"
	quest.3337DD355D021D68.title: "First Artifact"
	quest.3337DD355D021D68.quest_desc: [
		"Ruins and loot chests yield Artifacts. Claim any one and slot it into Curios - each slot fits a different body part."
		""
		"{\"text\":\"» See the manual: Artifacts & Curios Slots\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"215A050EB8A4CB9C\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Artifacts & Curios Slots\"}}"
	]
	quest.3337DD355D021D68.quest_subtitle: "Suggested stage: Survival Age"
	quest.44DA18379651CDA7.title: "Lunar & Martian Relics"
	quest.44DA18379651CDA7.quest_desc: [
		"Moon and Mars ruins hold tier-two relics. Bring back any one of them."
		""
		"{\"text\":\"» See the manual: Artifacts & Curios Slots\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"215A050EB8A4CB9C\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Artifacts & Curios Slots\"}}"
		"{\"text\":\"» See the manual: Alien Structures & Archaeology\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"706640814E58980D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Alien Structures & Archaeology\"}}"
	]
	quest.44DA18379651CDA7.quest_subtitle: "Suggested stage: Space Age"
	quest.6032F578C5F37DB7.title: "High-risk Relics"
	quest.6032F578C5F37DB7.quest_desc: [
		"Venus and Mercury hide tier-three relics in brutal conditions. Prepare, dive in, return with any one."
		""
		"{\"text\":\"» See the manual: Artifacts & Curios Slots\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"215A050EB8A4CB9C\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Artifacts & Curios Slots\"}}"
		"{\"text\":\"» See the manual: Alien Structures & Archaeology\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"706640814E58980D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Alien Structures & Archaeology\"}}"
	]
	quest.6032F578C5F37DB7.quest_subtitle: "Suggested stage: Space Age"
	quest.0CB50C41FBCD2682.title: "Frontier Relics"
	quest.0CB50C41FBCD2682.quest_desc: [
		"Glacio and the belt are the relic hunter's edge: the rarest finds live furthest out. Any one counts - no full set required."
		""
		"{\"text\":\"» See the manual: Artifacts & Curios Slots\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"215A050EB8A4CB9C\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Artifacts & Curios Slots\"}}"
		"{\"text\":\"» See the manual: Alien Structures & Archaeology\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"706640814E58980D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Alien Structures & Archaeology\"}}"
	]
	quest.0CB50C41FBCD2682.quest_subtitle: "Suggested stage: Space Age"
	quest.14C1933433AE2931.title: "Ecological Survey"
	quest.14C1933433AE2931.quest_desc: [
		"Log the anomalous fauna on the surface and below: enderman variants, arachnid broods, cave endemics. Notes suffice - no cull needed."
		""
		"{\"text\":\"» See the manual: Ecological Survey\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BE0F716B792B7F8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Ecological Survey\"}}"
	]
	quest.14C1933433AE2931.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.754414537A314DA3.title: "Arachnid Threat"
	quest.754414537A314DA3.quest_desc: [
		"Arachnid warriors tear at the perimeter. Kill 3 and mark their brood site."
		""
		"{\"text\":\"» See the manual: Ecological Survey\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BE0F716B792B7F8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Ecological Survey\"}}"
	]
	quest.754414537A314DA3.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.12E6FEFAE5AD67A7.title: "Alien Ecology"
	quest.12E6FEFAE5AD67A7.quest_desc: [
		"Native species on the Moon and Mars play by different rules. Document at least one alien habitat."
		""
		"{\"text\":\"» See the manual: Ecological Survey\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BE0F716B792B7F8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Ecological Survey\"}}"
	]
	quest.12E6FEFAE5AD67A7.quest_subtitle: "Suggested stage: Space Age"
	chapter.637830D327841CC8.title: "Exploration"
	chapter.637830D327841CC8.chapter_subtitle: [
		"Investigate ruins and anomalies for resources, blueprints, and industrial shortcuts."
	]
	quest.7C549AB52654538C.title: "A Kitchen That Feeds the Base"
	quest.7C549AB52654538C.quest_desc: [
		"Build fields, a cooking pot, and a shared kitchen with bowls and basic fuel. Make food easy for teammates to collect without repeatedly searching for ingredients."
		""
		"{\"text\":\"» See the manual: Kitchen Automation\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B1F9252FB11EAD5\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Kitchen Automation\"}}"
	]
	quest.7C549AB52654538C.quest_subtitle: "Suggested stage: Survival Age"
	quest.091668F16A21A35F.title: "Deliver the Harvest"
	quest.091668F16A21A35F.quest_desc: [
		"Connect farms, kitchens, and expedition supply chests. Keep staple reserves and check container returns and full storage to maintain reliable transport."
		""
		"{\"text\":\"» See the manual: Kitchen Automation\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B1F9252FB11EAD5\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Kitchen Automation\"}}"
	]
	quest.091668F16A21A35F.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.6B7786C4146F1A73.title: "Food First, Surplus for Fuel"
	quest.6B7786C4146F1A73.quest_desc: [
		"Support biofuel production with crops while reserving food and seeds first. Expand farming with industry so fuel production does not exhaust the food supply."
		""
		"{\"text\":\"» See the manual: The Unified Oil Economy\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1932C9CEA2E264BB\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"The Unified Oil Economy\"}}"
	]
	quest.6B7786C4146F1A73.quest_subtitle: "Suggested stage: Heavy Industry Age"
	quest.39AD03268D0C83AE.title: "Plant Your First Alien Greenhouse"
	quest.39AD03268D0C83AE.quest_desc: [
		"Prepare sealing, oxygen, light, water, and backup power for a lunar or Martian farm. Verify environmental conditions and crop suitability before scaling up."
	]
	quest.39AD03268D0C83AE.quest_subtitle: "Suggested stage: Space Age"
	quest.60EC892D396AFC26.title: "Breaking Ground"
	quest.60EC892D396AFC26.quest_desc: [
		"Plant the first wheat fields behind fencing: the kitchen gets a steady supply and nobody starves on horde night."
		""
		"{\"text\":\"» See the manual: Kitchen Automation\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B1F9252FB11EAD5\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Kitchen Automation\"}}"
	]
	quest.60EC892D396AFC26.quest_subtitle: "Suggested stage: Survival Age"
	quest.6E99CCD7093D32CF.title: "Ranch Online"
	quest.6E99CCD7093D32CF.quest_desc: [
		"Breeder and farmer blocks come online: food stops depending on fields alone, and leather, feathers, and fertilizer come along."
	]
	quest.6E99CCD7093D32CF.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.76B18E56A2AF597A.title: "Seasonal Stockpile"
	quest.76B18E56A2AF597A.quest_desc: [
		"Set aside a dedicated rations store for expeditions and horde seasons: preserved food and backup seeds, untouched until needed."
	]
	quest.76B18E56A2AF597A.quest_subtitle: "Suggested stage: Electrical Age"
	quest.5C08D931A3082653.title: "Bulk Pantry"
	quest.5C08D931A3082653.quest_desc: [
		"Bulk food and ingredients go to drawers; the kitchen keeps only hot stock. Drawers for bulk, barrels for mixed goods."
		""
		"{\"text\":\"» See the manual: Storage Tiers\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FBDC2FE9BA6964E\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Storage Tiers\"}}"
	]
	quest.5C08D931A3082653.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.46642DBD06A70ABC.title: "CFB Kitchen Network"
	quest.46642DBD06A70ABC.quest_desc: [
		"Table, sink and counters form a kitchen network: the cooking table reads every connected container. Wire fridge and counters into the same net."
		""
		"{\"text\":\"» See the manual: CFB Kitchen Networks\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"73E35DDDFAD2E809\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"CFB Kitchen Networks\"}}"
	]
	quest.46642DBD06A70ABC.quest_subtitle: "Suggested stage: Survival Age"
	quest.69AE0F6EE8647B0F.title: "Industrial Heat"
	quest.69AE0F6EE8647B0F.quest_desc: [
		"The electric burner gives kitchens and food lines steady heat instead of intermittent solid fuel."
		""
		"{\"text\":\"» See the manual: CFB Kitchen Networks\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"73E35DDDFAD2E809\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"CFB Kitchen Networks\"}}"
	]
	quest.69AE0F6EE8647B0F.quest_subtitle: "Suggested stage: Electrical Age"
	quest.3909E0CC792F88C2.title: "Automated Food Resupply"
	quest.3909E0CC792F88C2.quest_desc: [
		"Let logistics or the ME network restock kitchen ingredients by stock level - cooks just plate."
		""
		"{\"text\":\"» See the manual: Applied Cooking & the Digital Kitchen\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0A70E891FF739F21\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Applied Cooking & the Digital Kitchen\"}}"
	]
	quest.3909E0CC792F88C2.quest_subtitle: "Suggested stage: Information Age"
	quest.404A138A10525F39.title: "ME Food Network"
	quest.404A138A10525F39.quest_desc: [
		"Applied Cooking's kitchen station and Applied Delight's ME cookware hook food production into the digital network."
		""
		"{\"text\":\"» See the manual: Applied Cooking & the Digital Kitchen\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0A70E891FF739F21\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Applied Cooking & the Digital Kitchen\"}}"
	]
	quest.404A138A10525F39.quest_subtitle: "Suggested stage: Information Age"
	quest.72AC6BB895B11A07.title: "Colony Catering"
	quest.72AC6BB895B11A07.quest_desc: [
		"Once habitats and greenhouses join the food network, colony meals are dispatched by the system, not carried by hand."
		""
		"{\"text\":\"» See the manual: Applied Cooking & the Digital Kitchen\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0A70E891FF739F21\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Applied Cooking & the Digital Kitchen\"}}"
		"{\"text\":\"» See the manual: Lightweight Colonies\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5D67189820FB07DC\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Lightweight Colonies\"}}"
	]
	quest.72AC6BB895B11A07.quest_subtitle: "Suggested stage: Space Age"
	quest.2EDC7790CF384594.title: "Refurbished Kitchen"
	quest.2EDC7790CF384594.quest_desc: [
		"A kitchen drawer and a stove turn the pantry into a working kitchen. Refurbished storage blocks join the CFB network natively."
		""
		"{\"text\":\"» See the manual: Modern Kitchen\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E9D6B40063DF60A\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Modern Kitchen\"}}"
	]
	quest.2EDC7790CF384594.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.123AEA037FB67BAE.title: "Industrial Food Processing"
	quest.123AEA037FB67BAE.quest_desc: [
		"Craft the steel butcher knife and start IE machinery on food: cloche produce, press mince, squeeze sauces. The knife is the ticket into Engineers Delight recipes."
		""
		"{\"text\":\"» See the manual: Industrial Food Processing\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7AAC1E5061A9C042\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Industrial Food Processing\"}}"
	]
	quest.123AEA037FB67BAE.quest_subtitle: "Suggested stage: Electrical Age"
	quest.47A9DB924B7F855C.title: "Automated Food Factory"
	quest.47A9DB924B7F855C.quest_desc: [
		"Assemble Immersive Cooking multiblocks: cookpot and fermenter cover batch cooking and fermentation lines that feed the ME pantry."
		""
		"{\"text\":\"» See the manual: Food Automation\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7B0CAA52B3E70CE4\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Food Automation\"}}"
	]
	quest.47A9DB924B7F855C.quest_subtitle: "Suggested stage: Heavy Industry Age"
	chapter.4274BFE7FD246AAF.title: "Agriculture and Provisioning"
	chapter.4274BFE7FD246AAF.chapter_subtitle: [
		"Supply food, crops, and biofuel to factories, defenses, and colonies."
	]
	quest.67D80191074CCF3A.title: "Leave Room for the Factory to Grow"
	quest.67D80191074CCF3A.quest_desc: [
		"Plan workshops, storage, service corridors, and maintenance access. Establish an expandable layout before adding finishes. No fixed block count is required."
	]
	quest.67D80191074CCF3A.quest_subtitle: "Suggested stage: Survival Age"
	quest.6EB064B477848BC2.title: "Build at Industrial Scale"
	quest.6EB064B477848BC2.quest_desc: [
		"Make a basic building gadget and stock power and materials. Test placement and undo in a small area before building factories and roads."
	]
	quest.6EB064B477848BC2.quest_subtitle: "Suggested stage: Electrical Age"
	quest.5CD5CEBA5468B347.title: "Build a Maintainable Industrial District"
	quest.5CD5CEBA5468B347.quest_desc: [
		"Use steel frames, concrete, glass, and signs to organize power, production, and reserves. Preserve firing lanes and maintenance access; appearance does not replace real protection."
	]
	quest.5CD5CEBA5468B347.quest_subtitle: "Suggested stage: Heavy Industry Age"
	quest.26EC2B4817F9C25D.title: "Build Habitats That Support Survival"
	quest.26EC2B4817F9C25D.quest_desc: [
		"Separate living quarters, greenhouses, machinery, and quarantine areas. Provide clear routes and emergency reserves. Verify actual sealing rather than trusting a glass appearance."
		""
		"{\"text\":\"» See the manual: Three-Layer Defense\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"482CA592DE6BAB84\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Three-Layer Defense\"}}"
	]
	quest.26EC2B4817F9C25D.quest_subtitle: "Suggested stage: Space Age"
	quest.40DFD7A80A1BED57.title: "Bulk Materials"
	quest.40DFD7A80A1BED57.quest_desc: [
		"Concrete and glass roll into a dedicated stockpile: district expansion, colony buildings, and fortifications all draw from it."
	]
	quest.40DFD7A80A1BED57.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.751DE25742D71D15.title: "Swap and Copy"
	quest.751DE25742D71D15.quest_desc: [
		"The exchanging gadget swaps materials and the copy-paste gadget stamps structures — district-scale building speeds up by an order of magnitude."
	]
	quest.751DE25742D71D15.quest_subtitle: "Suggested stage: Heavy Industry Age"
	quest.13129660D86A5A69.title: "Demolition"
	quest.13129660D86A5A69.quest_desc: [
		"The destruction gadget clears ground safely: district rebuilds, accident cleanup, and terrain fixes no longer mean hand-picking."
	]
	quest.13129660D86A5A69.quest_subtitle: "Suggested stage: Atomic Age"
	quest.33137A5834F5A967.title: "Rest Quarters"
	quest.33137A5834F5A967.quest_desc: [
		"Zone a quiet rest area away from machines: beds, light, simple furniture. Keep living and industrial districts apart."
		""
		"{\"text\":\"» See the manual: Livable Base\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D4CAFB9EC9E6AC2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Livable Base\"}}"
	]
	quest.33137A5834F5A967.quest_subtitle: "Suggested stage: Survival Age"
	quest.7DE5C11A0F9E6A2B.title: "Mess Hall"
	quest.7DE5C11A0F9E6A2B.quest_desc: [
		"A mess hall next to the kitchen network: tables, seats, a serving counter. Food's last stop should be nearest the crew."
		""
		"{\"text\":\"» See the manual: Livable Base\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D4CAFB9EC9E6AC2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Livable Base\"}}"
		"{\"text\":\"» See the manual: CFB Kitchen Networks\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"73E35DDDFAD2E809\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"CFB Kitchen Networks\"}}"
	]
	quest.7DE5C11A0F9E6A2B.quest_subtitle: "Suggested stage: Survival Age"
	quest.3A9395C0631B98F1.title: "Crew Quarters"
	quest.3A9395C0631B98F1.quest_desc: [
		"Residents need real living units: beds, storage, work nooks, lit blocks. Macaw's and Refurbished furniture carry the livable feel."
		""
		"{\"text\":\"» See the manual: Livable Base\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D4CAFB9EC9E6AC2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Livable Base\"}}"
	]
	quest.3A9395C0631B98F1.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.18BFCE7EDAE35FD1.title: "Habitat Module"
	quest.18BFCE7EDAE35FD1.quest_desc: [
		"Off-world habitats need sealing, oxygen and standalone power - build pod, work bay, airlock."
		""
		"{\"text\":\"» See the manual: Livable Base\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D4CAFB9EC9E6AC2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Livable Base\"}}"
	]
	quest.18BFCE7EDAE35FD1.quest_subtitle: "Suggested stage: Space Age"
	quest.4544E4D977AE36CB.title: "Modern Living"
	quest.4544E4D977AE36CB.quest_desc: [
		"Refurbished furniture turns the base into a home: seating, tables, appliances. Comfort is the frame; power comes next."
		""
		"{\"text\":\"» See the manual: Modern Living\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7768292ADEE8BE72\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Modern Living\"}}"
	]
	quest.4544E4D977AE36CB.quest_subtitle: "Suggested stage: Mechanical Age"
	quest.4B1C27A3F2032C31.title: "Household Power"
	quest.4B1C27A3F2032C31.quest_desc: [
		"The Energized Furniture energy transformer feeds FE from the public grid into the Refurbished home network. Wire the house to the grid."
		""
		"{\"text\":\"» See the manual: Household Power\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3D52D8EF523B1359\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Household Power\"}}"
	]
	quest.4B1C27A3F2032C31.quest_subtitle: "Suggested stage: Electrical Age"
	quest.4A11931A05ECF04F.title: "Smart Home"
	quest.4A11931A05ECF04F.quest_desc: [
		"Place the computer, power it through the transformer, and open Home Control plus the Starforge apps to monitor the base."
		""
		"{\"text\":\"» See the manual: Smart Home\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"53235BFFFF0D5717\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Smart Home\"}}"
	]
	quest.4A11931A05ECF04F.quest_subtitle: "Suggested stage: Electrical Age"
	chapter.56F4CC5F9343242B.title: "Construction"
	chapter.56F4CC5F9343242B.chapter_subtitle: [
		"Build factories, bases, and stations that are easy to expand, maintain, and defend."
	]
	quest.306787D7CF3A4AAE.title: "Team Progression and Specialization"
	quest.306787D7CF3A4AAE.quest_desc: [
		"Teams share manufacturing research, while individuals may specialize. Buying a finished product does not grant manufacturing knowledge. The quest book provides guidance."
	]
	quest.306787D7CF3A4AAE.quest_subtitle: "Progression and Survival"
	quest.6B23A0DB3D268796.title: "The Earth-Sufficient Route"
	quest.6B23A0DB3D268796.quest_desc: [
		"Most basic resources and all required advanced materials are obtainable on Earth. Colonization saves materials and energy, and exploration provides shortcuts; neither is mandatory for industrial progress."
	]
	quest.6B23A0DB3D268796.quest_subtitle: "Progression and Survival"
	quest.08F61C4EED508F67.title: "Power Priority"
	quest.08F61C4EED508F67.quest_desc: [
		"Prioritize oxygen, emergency batteries, and basic defenses before kitchens and production. Separate essential facilities from heavy loads and maintain local reserves for outages."
	]
	quest.08F61C4EED508F67.quest_subtitle: "Power, Oil and Networks"
	quest.79F690776849AD03.title: "AE2 Cold Start"
	quest.79F690776849AD03.quest_desc: [
		"Run the inscriber on independent power first and make processors before the controller. The digital network reads drawers and storage controllers through storage buses; the FastPipes network still carries bulk transport while the digital layer schedules and crafts."
	]
	quest.79F690776849AD03.quest_subtitle: "Power, Oil and Networks"
	quest.4B5A9C30A8FBCA52.title: "The Safe Station"
	quest.4B5A9C30A8FBCA52.quest_desc: [
		"Stations have no hostile spawns by default but still require life support. Only explicitly enabled special events may create enemies. Keep quarantine areas separate from living quarters."
	]
	quest.4B5A9C30A8FBCA52.quest_subtitle: "Spaceflight and Hazards"
	quest.3B1F9252FB11EAD5.title: "Kitchen Automation"
	quest.3B1F9252FB11EAD5.quest_desc: [
		"The kitchen provides shared ingredients, while cooking pots prepare supported dishes. Verify input sides, output sides, bowls, and fuel handling before automating restocking. Reserve food before turning surplus crops into fuel."
	]
	quest.3B1F9252FB11EAD5.quest_subtitle: "Progression and Survival"
	quest.6AD45769D44A5F98.title: "Horde Sappers"
	quest.6AD45769D44A5F98.quest_desc: [
		"Engineers can remove obstacles or build paths within limits. Use layered defenses, clear firing lanes, and repair reserves, and prioritize units opening routes."
	]
	quest.6AD45769D44A5F98.quest_subtitle: "Hordes and Defense"
	quest.453A61A0B4D9C159.title: "The Storage Growth Path"
	quest.453A61A0B4D9C159.quest_desc: [
		"After chests and barrels, use drawers and versatile storage for bulk materials. Capacity, filtering, and compression upgrades open with the Electrical Age and consume industrial components. A digital network reads existing warehouses instead of replacing them."
	]
	quest.453A61A0B4D9C159.quest_subtitle: "Progression and Survival"
	quest.0E8B4E397AC0FBCA.title: "One Network: FastPipes"
	quest.0E8B4E397AC0FBCA.quest_desc: [
		"FastPipes is the pack's default general-purpose network: one pipe family carries items, fluids and FE. Extractor attachments pull from containers and machines with filters, redstone control and distribution modes; inserter attachments set delivery priority; sensor/void attachments handle signals and overflow; the terminal turns a pipe network into a searchable mini-warehouse. IE conveyors and fluid pipes stay for visible industrial lines; BuildCraft pipes remain a legacy option around its specialty machines (quarry, pump); Railcraft owns long-distance bulk freight; AE2 owns digital storage and autocrafting, not ordinary pipework. Power runs on one public FE grid: FastPipes energy pipes connect IE, Ad Astra, IC2CRE (native FE port) and Railcraft devices directly; BuildCraft converts with its own FE engine and MJ dynamo; Refurbished appliances join through the Energized Furniture transformer."
	]
	quest.0E8B4E397AC0FBCA.quest_subtitle: "Power, Oil and Networks"
	quest.28C9F6D61C4E55C2.title: "Backpacks and Expedition Kits"
	quest.28C9F6D61C4E55C2.quest_desc: [
		"Backpacks serve mining, engineering, exploration, expeditions, and colony construction. Basic packs open early; capacity, pickup, and resupply upgrades unlock by stage. A backpack is not factory logistics or a portable crafting network."
	]
	quest.28C9F6D61C4E55C2.quest_subtitle: "Progression and Survival"
	quest.1932C9CEA2E264BB.title: "The Unified Oil Economy"
	quest.1932C9CEA2E264BB.quest_desc: [
		"Oil fields feed one unified chain through FastPipes fluid pipes: petroleum refining, electrical control, and heavy processing produce fuels and chemicals for power, defense, and spaceflight. Both oil systems must share the same fluids and tags."
	]
	quest.1932C9CEA2E264BB.quest_subtitle: "Power, Oil and Networks"
	quest.5D67189820FB07DC.title: "Lightweight Colonies"
	quest.5D67189820FB07DC.quest_desc: [
		"A colony is an industrial outpost with a few residents, guards, and turrets — not a city simulation. Industry feeds the colony, the arms industry equips the guards, and guards and turrets protect industry."
	]
	quest.5D67189820FB07DC.quest_subtitle: "Residents and Garrisons"
	quest.6FBF02C8FB016AC6.title: "Colony Residents"
	quest.6FBF02C8FB016AC6.quest_desc: [
		"The first residents are recruited on Earth and arrive by rocket. Colony facilities handle growth: farming feeds them, housing expands the population, and trading posts exchange goods."
	]
	quest.6FBF02C8FB016AC6.quest_subtitle: "Residents and Garrisons"
	quest.4C0A7C642219B0D2.title: "Colony Guards"
	quest.4C0A7C642219B0D2.quest_desc: [
		"Guards patrol, defend interiors, and cover turret blind spots. Arm them with industrially produced guns and armor; civilians shelter during hordes instead of fighting."
	]
	quest.4C0A7C642219B0D2.quest_subtitle: "Residents and Garrisons"
	quest.15C288AF8333C644.title: "The Colony Armory"
	quest.15C288AF8333C644.quest_desc: [
		"Weapon production joins the industrial chain: refined metals, stamped parts, chemical propellants. Split roles into regular, marksman, heavy, and support instead of issuing endgame gear to every guard."
	]
	quest.15C288AF8333C644.quest_subtitle: "Residents and Garrisons"
	quest.4C15617E8C8DA7F9.title: "Ammunition Logistics"
	quest.4C15617E8C8DA7F9.quest_desc: [
		"Ammunition is part of the industrial economy: bullets, casings, and propellant come from production lines. Keep a separate infantry ammo stock; guards draw from nearby chests."
	]
	quest.4C15617E8C8DA7F9.quest_subtitle: "Residents and Garrisons"
	quest.744853EABC0E1648.title: "Colony Supply Chains"
	quest.744853EABC0E1648.quest_desc: [
		"Supply chains keep local buffers: stock thresholds restock forward crates over physical logistics. If the network fails, the garrison fights on local reserves."
	]
	quest.744853EABC0E1648.quest_subtitle: "Residents and Garrisons"
	quest.482CA592DE6BAB84.title: "Three-Layer Defense"
	quest.482CA592DE6BAB84.quest_desc: [
		"Three defensive layers share the work: turrets hold the perimeter and main firing lines, guards cover interiors and blind spots, and players handle elites, sappers, and breaches."
	]
	quest.482CA592DE6BAB84.quest_subtitle: "Hordes and Defense"
	quest.1630974DE79170F7.title: "Colony Defense Pressure"
	quest.1630974DE79170F7.quest_desc: [
		"Colony hordes apply pressure through tactics, numbers, and specialist units rather than inflated health pools. Keep reserves of ammunition, power, food, and repairs."
	]
	quest.1630974DE79170F7.quest_subtitle: "Hordes and Defense"
	quest.6D57B198ED6623C4.title: "Layered Base Defense"
	quest.6D57B198ED6623C4.quest_desc: [
		"Defense is layered by firepower: IE sentries cover early industrial fixed defense; TACZ auto-turrets cover late military automation (gun + ammo box); armed guards are mobile infantry; players handle high-value targets, emergency repairs, and collapse response. Never bet the base on one turret type."
	]
	quest.6D57B198ED6623C4.quest_subtitle: "Hordes and Defense"
	quest.2E55B63F9D911701.title: "Auto-Turrets: Loading & Resupply"
	quest.2E55B63F9D911701.quest_desc: [
		"A TACZ turret takes a TaCZ gun by click or dropped item. It draws ammunition from the chest beneath or beside it — the last mile: FastPipes and AE2 keep the box filled, the turret draws from it. Its lamp shows reloading / empty / ready states."
	]
	quest.2E55B63F9D911701.quest_subtitle: "Hordes and Defense"
	quest.60BD0CCFC3034959.title: "EOS Dawn Goddess Lab Weapons"
	quest.60BD0CCFC3034959.quest_desc: [
		"The EOS arsenal is the heavy sci-fi layer: gauss firearms (HG-57, AR-68, MG-85), ELP plasma weapons (ELP-13 to ELP-72), and exotic ordnance (Helena's Nail, Clover Cross, Achilles). They unlock via staged industrial materials and cost far more ammunition than conventional guns. EOS recipes run on the EOS Printer workbench — craft it from polished deepslate, iron, copper and yellow glass."
	]
	quest.60BD0CCFC3034959.quest_subtitle: "Hordes and Defense"
	quest.725FD622502D6892.title: "Choosing Guard Weapons"
	quest.725FD622502D6892.quest_desc: [
		"Guard Villagers can wield TaCZ guns. Issue only dependable conventional weapons — rifles, SMGs, shotguns. Never hand out explosives, AoE, or exotic-mechanic weapons; the colony cannot afford friendly fire."
	]
	quest.725FD622502D6892.quest_subtitle: "Hordes and Defense"
	quest.009B2C59FE3D645E.title: "TaCZ Addon: Gunsmith Assistant"
	quest.009B2C59FE3D645E.quest_desc: [
		"TaCZ Addon streamlines the gun smith table: per-gun attachment and ammo filtering, material lists, JEI recipe lookups, batch crafting, and pulling materials from nearby containers and backpacks. It reduces busywork — never crafting cost."
	]
	quest.009B2C59FE3D645E.quest_subtitle: "Hordes and Defense"
	quest.76E5B544AD6A0494.title: "Expedition Ammunition Prep"
	quest.76E5B544AD6A0494.quest_desc: [
		"Stock up by consumption rate before departing: estimate conventional guns by combat time × fire rate, and pack extra heavy ammo for EOS weapons. Until a quantum bridge links your main stockpile, backpacks and ammo boxes are your entire supply line."
	]
	quest.76E5B544AD6A0494.quest_subtitle: "Spaceflight and Hazards"
	quest.4D5475C44C18F8A3.title: "Garrisons per Planet"
	quest.4D5475C44C18F8A3.quest_desc: [
		"Each planet needs a different garrison: Mars relies on turrets against swarms, Glacio needs armor-piercing firepower, Mercury keeps only a few elites. Unloaded colonies consume no processing."
	]
	quest.4D5475C44C18F8A3.quest_subtitle: "Residents and Garrisons"
	quest.64258511A9B2A6A2.title: "Colony Jobs"
	quest.64258511A9B2A6A2.quest_desc: [
		"Residents take jobs at workstations: farming, provisioning, storage, mechanics, electrical, ordnance, networks, heavy industry, life support, and aerospace. Jobs amplify industrial efficiency, but unmanned production lines still run fully."
	]
	quest.64258511A9B2A6A2.quest_subtitle: "Jobs and Maintenance"
	quest.42C7021D8B191D18.title: "Job Assignment"
	quest.42C7021D8B191D18.quest_desc: [
		"Jobs bind to their home base and never apply across planets. Job benefits diminish with repetition on the same line; guards are a military post and hold no industrial role."
	]
	quest.42C7021D8B191D18.quest_subtitle: "Jobs and Maintenance"
	quest.0B6171AAE7597875.title: "Maintenance and Returns"
	quest.0B6171AAE7597875.quest_desc: [
		"Maintenance spends industrial materials for efficiency and stability: well-maintained lines gain modest bonuses, while unmaintained ones keep running without shutdowns or damage."
	]
	quest.0B6171AAE7597875.quest_subtitle: "Jobs and Maintenance"
	quest.4642427A4336C17F.title: "Rail Logistics"
	quest.4642427A4336C17F.quest_desc: [
		"Railways carry high-throughput freight between bases, mines, and spaceports: cargo carts for bulk items, tank carts for fluids, loaders bridging storage at both ends. FastPipes networks serve inside bases; the digital network schedules rather than replaces trains."
	]
	quest.4642427A4336C17F.quest_subtitle: "Rail Logistics"
	quest.4BD992661353F0B8.title: "Spaceport Rail"
	quest.4BD992661353F0B8.quest_desc: [
		"A spaceport is the railway's terminus, not its replacement: mine trains feed the sorting yard while fuel and oxygen arrive by fluid loading. Colonies can link landing zone, mines, oxygen plant, and pads the same way."
	]
	quest.4BD992661353F0B8.quest_subtitle: "Rail Logistics"
	quest.344ED9F136392B5D.title: "Space Utility Gear"
	quest.344ED9F136392B5D.quest_desc: [
		"Oxygen cans are portable oxygen storage, fuel loaders refill rockets automatically, and rocket sensors plus gravity normalizers simplify base automation. These devices unlock in the Space Age and still cost real materials."
	]
	quest.344ED9F136392B5D.quest_subtitle: "Spaceflight and Hazards"
	quest.2BFD78A0764A92FF.title: "Asteroid Belt Hazards"
	quest.2BFD78A0764A92FF.quest_desc: [
		"The Asteroid Belt is a vacuum mining zone: near-zero gravity, no oxygen, no natural footing. A failed landing can permanently cost the rocket — always carry a return plan and a spare launch option."
	]
	quest.2BFD78A0764A92FF.quest_subtitle: "Spaceflight and Hazards"
	quest.215A050EB8A4CB9C.title: "Artifacts & Curios Slots"
	quest.215A050EB8A4CB9C.quest_desc: [
		"Artifacts slot into Curios, not armor: necklace, belt, gloves and head each have a place. Hover a relic to see its tier (Earth > Moon/Mars > Venus/Mercury > Glacio/Belt). Rare relics name their home - check the questbook slot before equipping."
	]
	quest.215A050EB8A4CB9C.quest_subtitle: "Field & Ruins"
	quest.706640814E58980D.title: "Alien Structures & Archaeology"
	quest.706640814E58980D.quest_desc: [
		"Moon and Mars surfaces hold explorable structures: derelict bases, crashed ships, colony ruins. Venus and Mercury sites are harsher and richer. Before entering any alien structure, confirm oxygen and return fuel - take loot and block data, no need to clear."
	]
	quest.706640814E58980D.quest_subtitle: "Field & Ruins"
	quest.6BE0F716B792B7F8.title: "Ecological Survey"
	quest.6BE0F716B792B7F8.quest_desc: [
		"Mobs here occupy niches: Enderman Overhaul variants split by biome, Creature Feature holds caves and water, Arachnids swarm, and each planet has natives. Log habitat and behavior; rares are optional - the logbook is no exam."
	]
	quest.6BE0F716B792B7F8.quest_subtitle: "Field & Ruins"
	quest.5FBDC2FE9BA6964E.title: "Storage Tiers"
	quest.5FBDC2FE9BA6964E.quest_desc: [
		"Storage tiers by role: Storage Drawers hold bulk single materials (ingots, food, stone) with compacting drawers auto-merging tiers; Sophisticated Storage runs mixed warehouses and limited barrels; Sophisticated Backpacks own field carry; AE2 handles digital indexing and autocrafting while FastPipes/Railcraft move the freight. Bulk to drawers, mixed to barrels, field to packs, index to ME."
	]
	quest.5FBDC2FE9BA6964E.quest_subtitle: "Progression and Survival"
	quest.0D8C96A7B6F83F18.title: "Expedition Loadouts"
	quest.0D8C96A7B6F83F18.quest_desc: [
		"Kit backpacks per mission: field survey takes pickup+magnet; combat runs stack+supplies; planetary trips add oxygen tanks and rations. Backpacks coexist with Curios - check keybinds and keep spare mags in a mag pouch."
	]
	quest.0D8C96A7B6F83F18.quest_subtitle: "Progression and Survival"
	quest.0D4CAFB9EC9E6AC2.title: "Livable Base"
	quest.0D4CAFB9EC9E6AC2.quest_desc: [
		"Split the base into industry and living: machines cluster under one management, living quarters get beds, mess, rest zones and light. Macaw's, Refurbished, Supplementaries and FramedBlocks carry comfort - framed blocks take any texture. Off-world pods build airlock-habitat-workbay and carry their own oxygen."
	]
	quest.0D4CAFB9EC9E6AC2.quest_subtitle: "Residents and Garrisons"
	quest.73E35DDDFAD2E809.title: "CFB Kitchen Networks"
	quest.73E35DDDFAD2E809.quest_desc: [
		"The CFB cooking table is the kitchen terminal: it reads every connected container and plates meals directly. The sink supplies water, fridge and counters extend stock, the oven batch-cooks. Link containers with kitchen connectors or one shared network, then serve from the terminal."
	]
	quest.73E35DDDFAD2E809.quest_subtitle: "Progression and Survival"
	quest.0A70E891FF739F21.title: "Applied Cooking & the Digital Kitchen"
	quest.0A70E891FF739F21.quest_desc: [
		"Applied Cooking hooks kitchens into ME: the kitchen station lets the network pull ingredients directly, and Applied Delight's ME cookware turns the cooking pot into a network device. With stock levels and autocrafting, food shifts from hand-made to on-demand."
	]
	quest.0A70E891FF739F21.quest_subtitle: "Progression and Survival"
	quest.46C8EE9AF7A2DC7E.title: "Low-g & Alien Combat"
	quest.46C8EE9AF7A2DC7E.quest_desc: [
		"Planetary gravity runs low: higher jumps, slower falls, recoil pushes harder and thrown arcs change. Test handling before contact; against fast natives, slows and control win. Oxygen margin is always the first stat."
	]
	quest.46C8EE9AF7A2DC7E.quest_subtitle: "Hordes and Defense"
	quest.5FB73CF25E88351B.title: "Advanced Railcraft"
	quest.5FB73CF25E88351B.quest_desc: [
		"Advanced rail rests on four things: block signals cut the line into sections, interlock boxes keep one train per block; electric locomotives draw from the grid; high-speed track wants buffers and speed corners; the tunnel bore cuts and lays on its own. Plan trunk lines section first, signal second, rail last."
	]
	quest.5FB73CF25E88351B.quest_subtitle: "Rail Logistics"
	quest.2CE7350DEA19BCD0.title: "Client Utilities"
	quest.2CE7350DEA19BCD0.quest_desc: [
		"These mods only touch your client, never progression: EMI for recipes, Jade for block info, Xaero maps for waypoints, Inventory Profiles for sorting, Mouse Tweaks for drags, AppleSkin for hunger, Better F3 for coords, ShulkerBoxTooltip for box previews, Controlling for keybinds. Configure to taste - none of them gates anything."
	]
	quest.2CE7350DEA19BCD0.quest_subtitle: "Progression and Survival"
	quest.7768292ADEE8BE72.title: "Modern Living"
	quest.7768292ADEE8BE72.quest_desc: [
		"Refurbished covers the full home: chairs, tables, sofas, kitchen cabinetry, lamps and storage. Furniture is plain decor until powered; fridges and drawers double as real containers that CFB can read."
	]
	quest.7768292ADEE8BE72.quest_subtitle: "Residents and Garrisons"
	quest.3D52D8EF523B1359.title: "Household Power"
	quest.3D52D8EF523B1359.quest_desc: [
		"Refurbished runs its own electricity. Place the Energized Furniture transformer, feed it FE from the grid, and it powers nearby appliances. Generators and the computer all sit on that home network."
	]
	quest.3D52D8EF523B1359.quest_subtitle: "Power, Oil and Networks"
	quest.53235BFFFF0D5717.title: "Smart Home"
	quest.53235BFFFF0D5717.quest_desc: [
		"The computer ships with Paddle Ball, Home Control, Marketplace and Coin Miner. Starforge adds two apps: Starforge Control for base telemetry and Security for alarm and defense state. Everything else stays untouched."
	]
	quest.53235BFFFF0D5717.quest_subtitle: "Power, Oil and Networks"
	quest.0E9D6B40063DF60A.title: "Modern Kitchen"
	quest.0E9D6B40063DF60A.quest_desc: [
		"Refurbished kitchen blocks are CFB-aware: drawers, fridges and cabinetry are item providers; sinks and appliances are connectors. One cooking table reads the whole kitchen."
	]
	quest.0E9D6B40063DF60A.quest_subtitle: "Progression and Survival"
	quest.7AAC1E5061A9C042.title: "Industrial Food Processing"
	quest.7AAC1E5061A9C042.quest_desc: [
		"Engineers Delight maps food onto IE machines: garden cloche grows crops, the metal press minces, squeezer extracts, fermenter brews. Steel butcher knife gates the tier. Mid-scale only; throughput comes later."
	]
	quest.7AAC1E5061A9C042.quest_subtitle: "Progression and Survival"
	quest.7B0CAA52B3E70CE4.title: "Food Automation"
	quest.7B0CAA52B3E70CE4.quest_desc: [
		"Immersive Cooking & Farming adds cookpot, fermenter, food processor and grill multiblocks for high-volume lines. Stage them after IE processing and pipe output to AE2."
	]
	quest.7B0CAA52B3E70CE4.quest_subtitle: "Progression and Survival"
	chapter.13F04EAD5AD7B827.title: "Reference Manual"
	chapter.13F04EAD5AD7B827.chapter_subtitle: [
		"Long-form guides by topic: progression rules, power, defense, colonies, jobs, rail, and spaceflight risks. Links inside quest descriptions jump here."
	]
}
