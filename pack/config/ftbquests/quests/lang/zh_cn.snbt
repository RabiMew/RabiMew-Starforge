	]
	quest.0E79A6A14CA31F91.quest_subtitle: "推荐阶段：生存时代"
	quest.0D1AC1E27C5540EB.title: "团队与进度"
	quest.0D1AC1E27C5540EB.quest_desc: [
		"团队共享制造研究，新成员加入即同步。个人可以自由专精不同路线；买到成品不会自动获得制造权限。"
		""
		"{\"text\":\"» 详见手册：团队进度与个人专精\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"306787D7CF3A4AAE\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"团队进度与个人专精\"}}"
		"{\"text\":\"» 详见手册：地球自给路线\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6B23A0DB3D268796\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"地球自给路线\"}}"
	]
	quest.0D1AC1E27C5540EB.quest_subtitle: "推荐阶段：生存时代"
	quest.13CFB46ABD3B5830.title: "第一个营地"
	quest.13CFB46ABD3B5830.quest_desc: [
		"建立庇护所、床、储物和起步农田。照明与围栏是防线的第一层。"
	]
	quest.13CFB46ABD3B5830.quest_subtitle: "推荐阶段：生存时代"
	quest.2F3A025FCA06D48B.title: "第一口锅"
	quest.2F3A025FCA06D48B.quest_desc: [
		"制作农夫乐事烹饪锅，让厨房能集中供餐。农田与仓储的进阶见农业与后勤章。"
		""
		"{\"text\":\"» 详见手册：厨房自动化\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B1F9252FB11EAD5\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"厨房自动化\"}}"
	]
	quest.2F3A025FCA06D48B.quest_subtitle: "推荐阶段：生存时代"
	quest.4CD255DB2734A955.title: "工程装配件"
	quest.4CD255DB2734A955.quest_desc: [
		"手工制成工程装配件，团队进入机械时代。晋级凭证一律由制造触发，不靠提交或拾取。"
		""
		"{\"text\":\"» 详见手册：仓储成长路线\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"453A61A0B4D9C159\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"仓储成长路线\"}}"
	]
	quest.4CD255DB2734A955.quest_subtitle: "推荐阶段：生存时代"
	quest.6FD4163A437DB329.title: "登记基地"
	quest.6FD4163A437DB329.quest_desc: [
		"在基地状态界面登记主基地：威胁、补给、氧气与电力都按登记范围统计。搬迁后可重新登记。"
	]
	quest.6FD4163A437DB329.quest_subtitle: "推荐阶段：生存时代"
	quest.4A5C4FDCC304869D.title: "七条路线"
	quest.4A5C4FDCC304869D.quest_desc: [
		"任务书七章对应七条长期路线，全部可见、无强制顺序。挑顺手的开始，其余交给队友或以后再说。"
	]
	quest.4A5C4FDCC304869D.quest_subtitle: "推荐阶段：生存时代"
	quest.04678E0F669135E0.title: "铁器三件套"
	quest.04678E0F669135E0.quest_desc: [
		"备齐铁镐、铁剑与铁桶：下矿、自卫、装水，一件都不能少。"
	]
	quest.04678E0F669135E0.quest_subtitle: "推荐阶段：生存时代"
	quest.13C6FDBBC0A6A1F8.title: "打开阶段图谱"
	quest.13C6FDBBC0A6A1F8.quest_desc: [
		"背包界面左侧的按钮会打开 ProgressiveStages 图谱：时代主线、能力分支与每个节点的解锁条件都在那里。任务书只负责路线与说明。"
		""
		"{\"text\":\"» 详见手册：团队进度与个人专精\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"306787D7CF3A4AAE\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"团队进度与个人专精\"}}"
	]
	quest.13C6FDBBC0A6A1F8.quest_subtitle: "推荐阶段：生存时代"
	chapter.55C7495156B62A20.title: "启程"
	chapter.55C7495156B62A20.chapter_subtitle: [
		"从营地到第一台机器的起步引导：认识任务书、团队进度、厨房、晋级凭证与基地登记。"
	]
	quest.08529A1698B8AB8E.title: "第一套工业供电"
	quest.08529A1698B8AB8E.quest_desc: [
		"准备基础电路、发电机和安全接线。先让一台机器稳定运行，再逐步扩大电网；无需提交或消耗设备。"
		""
		"{\"text\":\"» 详见手册：电力优先级\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"08F61C4EED508F67\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"电力优先级\"}}"
	]
	quest.08529A1698B8AB8E.quest_subtitle: "推荐阶段：机械时代"
	quest.2539374E4F2A6024.title: "让每块矿石更有价值"
	quest.2539374E4F2A6024.quest_desc: [
		"把矿场原料送入工业处理线，分别收集主产物与副产物。检查输入是否堵塞，确认粉末不会被反复当成原矿加工。"
	]
	quest.2539374E4F2A6024.quest_subtitle: "推荐阶段：电气时代"
	quest.43D15883966FA564.title: "为大工业提供稳定电力"
	quest.43D15883966FA564.quest_desc: [
		"规划反应堆、冷却、隔离和备用供电。先测试停机与故障时的处理，再让关键生产线接入。"
		""
		"{\"text\":\"» 详见手册：电力优先级\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"08F61C4EED508F67\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"电力优先级\"}}"
	]
	quest.43D15883966FA564.quest_subtitle: "推荐阶段：原子时代"
	quest.3046722B35FDD226.title: "地球上的量子工业"
	quest.3046722B35FDD226.quest_desc: [
		"通过地球精炼取得首份铱，再建立通用物质扫描与复制流程。量子控制组件不要求外星资源或首领掉落。"
	]
	quest.3046722B35FDD226.quest_subtitle: "推荐阶段：量子时代"
	quest.13C7D62337B55213.title: "布线入门"
	quest.13C7D62337B55213.quest_desc: [
		"给发电机接上铜缆与电池盒：电要能发，更要能存能送。线路先走短距离，电网扩张留到后面。"
		""
		"{\"text\":\"» 详见手册：电力优先级\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"08F61C4EED508F67\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"电力优先级\"}}"
		"{\"text\":\"» 详见手册：统一管网：FastPipes\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E8B4E397AC0FBCA\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"统一管网：FastPipes\"}}"
	]
	quest.13C7D62337B55213.quest_subtitle: "推荐阶段：机械时代"
	quest.661C32BC2172153E.title: "首批电机"
	quest.661C32BC2172153E.quest_desc: [
		"电炉与压缩机上线：烧炼、成型不再靠煤，工业的第一批用电设备就位。"
	]
	quest.661C32BC2172153E.quest_subtitle: "推荐阶段：机械时代"
	quest.74254B1A5ACF0303.title: "第一炉钢"
	quest.74254B1A5ACF0303.quest_desc: [
		"焦炉烧焦煤、高炉炼钢锭。钢是铁路、炮塔与重型结构的共同地基，趁早把产线立起来。"
	]
	quest.74254B1A5ACF0303.quest_subtitle: "推荐阶段：机械时代"
	quest.5AA32800D1C581FB.title: "石油起步"
	quest.5AA32800D1C581FB.quest_desc: [
		"用泵抽出原油，FastPipes 流体管送回储罐。统一石油链的第一步：先让液体流进基地，再谈精炼与化工。"
		""
		"{\"text\":\"» 详见手册：统一石油经济\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1932C9CEA2E264BB\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"统一石油经济\"}}"
	]
	quest.5AA32800D1C581FB.quest_subtitle: "推荐阶段：电气时代"
	quest.32189FD328AB1060.title: "电子元件"
	quest.32189FD328AB1060.quest_desc: [
		"电路板与电子管批量备料——之后每台机器、每组信号、每条产线都要吃这两样。"
	]
	quest.32189FD328AB1060.quest_subtitle: "推荐阶段：电气时代"
	quest.12BF8F4E036DE8B1.title: "重型机械框架"
	quest.12BF8F4E036DE8B1.quest_desc: [
		"重型工程块与电弧炉落地：钢与电子件在这里汇流，产能进入重工业量级。"
	]
	quest.12BF8F4E036DE8B1.quest_subtitle: "推荐阶段：重工业时代"
	quest.45E40F3C3FF4ED9C.title: "反应堆大厅"
	quest.45E40F3C3FF4ED9C.quest_desc: [
		"核反应堆、反应室与屏蔽层——核电网的硬件底座。先把壳造好，再谈并网发电。"
	]
	quest.45E40F3C3FF4ED9C.quest_subtitle: "推荐阶段：原子时代"
	chapter.6FCE566CEE4CE64E.title: "工业工程"
	chapter.6FCE566CEE4CE64E.chapter_subtitle: [
		"提供电力、电路和高级材料，让整个工业体系持续运转。"
	]
	quest.1E6E9ECA6921E56E.title: "从箱子到生产线"
	quest.1E6E9ECA6921E56E.quest_desc: [
		"为大宗矿物、金属锭、零件和农产品准备抽屉与通用仓储，再用 FastPipes 物品管道与抽取附件接入机器。先设计满仓去向与停机信号，再提升运输速度。"
		""
		"{\"text\":\"» 详见手册：仓储成长路线\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"453A61A0B4D9C159\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"仓储成长路线\"}}"
		"{\"text\":\"» 详见手册：统一管网：FastPipes\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E8B4E397AC0FBCA\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"统一管网：FastPipes\"}}"
	]
	quest.1E6E9ECA6921E56E.quest_subtitle: "推荐阶段：机械时代"
	quest.4F47C604F5D375CC.title: "启动第一个数字仓库"
	quest.4F47C604F5D375CC.quest_desc: [
		"先以独立电源驱动压印机制作处理器，再让数字网络通过存储总线接管现有实体仓库。模板有地球制造途径，寻找陨石只是可选捷径；抽屉与库房仍然保留价值。"
		""
		"{\"text\":\"» 详见手册：AE2 冷启动\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"79F690776849AD03\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"AE2 冷启动\"}}"
	]
	quest.4F47C604F5D375CC.quest_subtitle: "推荐阶段：信息时代"
	quest.401D4EAB9AB4A6E1.title: "按库存安排生产"
	quest.401D4EAB9AB4A6E1.quest_desc: [
		"用仓储控制器汇总实体库存，再为电路、弹药和食物设置补货阈值。优先补充关键物资，并为满仓、断电和缺料留下处理方法。"
	]
	quest.401D4EAB9AB4A6E1.quest_subtitle: "推荐阶段：信息时代"
	quest.4B11C059543966A4.title: "弹药补给链"
	quest.4B11C059543966A4.quest_desc: [
		"军工厂 → 弹药仓库 → 物流干线 → 前线弹药箱。用库存阈值让物流系统自动补箱，炮塔与守卫只管开火。"
		""
		"{\"text\":\"» 详见手册：自动炮塔：装枪与补给\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2E55B63F9D911701\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"自动炮塔：装枪与补给\"}}"
	]
	quest.4B11C059543966A4.quest_subtitle: "推荐阶段：信息时代"
	quest.4B4C77575CC4219A.title: "连接远端基地"
	quest.4B4C77575CC4219A.quest_desc: [
		"用量子桥连接两端已供电、已加载的网络，并保留当地缓冲库存。链路断开时，基地应能继续维持基本运转。"
	]
	quest.4B4C77575CC4219A.quest_subtitle: "推荐阶段：量子时代"
	quest.1E674A8A5C906BBF.title: "建立铁路货运网"
	quest.1E674A8A5C906BBF.quest_desc: [
		"用货运列车把矿区与工业基地连接起来：货运车厢与罐车承担大宗运输，装卸机负责两端交接。基地内部的短距离运输仍交给管道与传送带。"
		""
		"{\"text\":\"» 详见手册：铁路物流\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4642427A4336C17F\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"铁路物流\"}}"
	]
	quest.1E674A8A5C906BBF.quest_subtitle: "推荐阶段：机械时代"
	quest.3991787934E071A4.title: "把铁路修进星港"
	quest.3991787934E071A4.quest_desc: [
		"让矿区货运列车直达发射场：列车进入分拣与仓储网络，再由燃料装载与火箭完成星际段。殖民地的登陆区、矿场、氧气区与发射场之间同样适用。"
		""
		"{\"text\":\"» 详见手册：星港铁路\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4BD992661353F0B8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"星港铁路\"}}"
	]
	quest.3991787934E071A4.quest_subtitle: "推荐阶段：太空时代"
	quest.55D5885078439343.title: "仓储接驳"
	quest.55D5885078439343.quest_desc: [
		"抽取附件取货、物品管道运输：把散装产线经 FastPipes 接进统一仓储，让每一箱原料都有去处。"
		""
		"{\"text\":\"» 详见手册：仓储成长路线\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"453A61A0B4D9C159\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"仓储成长路线\"}}"
		"{\"text\":\"» 详见手册：统一管网：FastPipes\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E8B4E397AC0FBCA\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"统一管网：FastPipes\"}}"
	]
	quest.55D5885078439343.quest_subtitle: "推荐阶段：机械时代"
	quest.0DB724B7A030812E.title: "信号闭塞"
	quest.0DB724B7A030812E.quest_desc: [
		"信号电路与闭塞信号机上线：列车按区段运行，干线不再互相追尾。"
		""
		"{\"text\":\"» 详见手册：铁路物流\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4642427A4336C17F\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"铁路物流\"}}"
	]
	quest.0DB724B7A030812E.quest_subtitle: "推荐阶段：电气时代"
	quest.3FDA41ACF6A75A22.title: "数字网络上线"
	quest.3FDA41ACF6A75A22.quest_desc: [
		"控制器、能源元件、存储总线——网络开始读取实体仓储。先小网跑通，再谈自动化。"
		""
		"{\"text\":\"» 详见手册：AE2 冷启动\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"79F690776849AD03\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"AE2 冷启动\"}}"
	]
	quest.3FDA41ACF6A75A22.quest_subtitle: "推荐阶段：信息时代"
	quest.0456D2DC6A3C47D0.title: "自动合成"
	quest.0456D2DC6A3C47D0.quest_desc: [
		"合成单元、分子装配室、样板供应器：网络从此能自己动手做东西，而不只是存东西。"
	]
	quest.0456D2DC6A3C47D0.quest_subtitle: "推荐阶段：信息时代"
	quest.7D9816358D597DD3.title: "抽屉仓储墙"
	quest.7D9816358D597DD3.quest_desc: [
		"满墙抽屉按压缩等级分层：普通抽屉存常规散料，压缩抽屉把锭/块/粒自动归并。"
		""
		"{\"text\":\"» 详见手册：仓储分层\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FBDC2FE9BA6964E\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"仓储分层\"}}"
	]
	quest.7D9816358D597DD3.quest_subtitle: "推荐阶段：机械时代"
	quest.17E40D93D5F53AAE.title: "通用仓储网络"
	quest.17E40D93D5F53AAE.quest_desc: [
		"Sophisticated Storage 控制器把木桶与限量桶连成可检索仓库，负责抽屉之外的杂项物资。"
		""
		"{\"text\":\"» 详见手册：仓储分层\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FBDC2FE9BA6964E\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"仓储分层\"}}"
	]
	quest.17E40D93D5F53AAE.quest_subtitle: "推荐阶段：电气时代"
	quest.284763ACA7D3BC91.title: "远征背包"
	quest.284763ACA7D3BC91.quest_desc: [
		"Sophisticated Backpacks 是野战物流核心：拾取升级自动入包，磁铁、熔炉、堆叠升级按任务配置。"
		""
		"{\"text\":\"» 详见手册：远征背包配置\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D8C96A7B6F83F18\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"远征背包配置\"}}"
	]
	quest.284763ACA7D3BC91.quest_subtitle: "推荐阶段：机械时代"
	quest.49FEF6A934F5A795.title: "蒸汽动力"
	quest.49FEF6A934F5A795.quest_desc: [
		"Railcraft 锅炉与汽轮机是早期的可靠电源：液体燃烧室吃燃油，高压锅炉出高压蒸汽。"
		""
		"{\"text\":\"» 详见手册：高级铁路\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FB73CF25E88351B\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"高级铁路\"}}"
	]
	quest.49FEF6A934F5A795.quest_subtitle: "推荐阶段：电气时代"
	quest.1736F25A60869410.title: "自动装卸"
	quest.1736F25A60869410.quest_desc: [
		"高级装卸器按过滤器精确配车，流体装卸器接管罐车——月台不再需要人工盯箱。"
		""
		"{\"text\":\"» 详见手册：高级铁路\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FB73CF25E88351B\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"高级铁路\"}}"
	]
	quest.1736F25A60869410.quest_subtitle: "推荐阶段：重工业时代"
	quest.45FDF56BACC668EF.title: "信号联锁"
	quest.45FDF56BACC668EF.quest_desc: [
		"控制箱、接收箱与令牌箱把闭塞区间连成联锁：列车进区间前必须持有对应令牌。"
		""
		"{\"text\":\"» 详见手册：高级铁路\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FB73CF25E88351B\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"高级铁路\"}}"
	]
	quest.45FDF56BACC668EF.quest_subtitle: "推荐阶段：电气时代"
	quest.37063572DC618E0A.title: "隧道掘进机"
	quest.37063572DC618E0A.quest_desc: [
		"隧道掘进机装填钢钻头与轨道包，可以沿直线自动开洞铺轨。给它留好补给车。"
		""
		"{\"text\":\"» 详见手册：高级铁路\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FB73CF25E88351B\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"高级铁路\"}}"
	]
	quest.37063572DC618E0A.quest_subtitle: "推荐阶段：重工业时代"
	quest.449D3297E192B8CE.title: "高速铁路"
	quest.449D3297E192B8CE.quest_desc: [
		"高速轨道必须配信号与挡停设施，弯道请减速。电力高速轨让机车自己供电。"
		""
		"{\"text\":\"» 详见手册：高级铁路\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FB73CF25E88351B\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"高级铁路\"}}"
	]
	quest.449D3297E192B8CE.quest_subtitle: "推荐阶段：重工业时代"
	quest.1A9D2B725EB00DDE.title: "星际枢纽"
	quest.1A9D2B725EB00DDE.quest_desc: [
		"把发射场、仓储和装卸月台接入同一条铁路干线：燃料、氧气、补给一车到底。"
		""
		"{\"text\":\"» 详见手册：星港铁路\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4BD992661353F0B8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"星港铁路\"}}"
	]
	quest.1A9D2B725EB00DDE.quest_subtitle: "推荐阶段：太空时代"
	chapter.17B3058067D055B5.title: "自动化与物流"
	chapter.17B3058067D055B5.chapter_subtitle: [
		"连接原料、机器与需求，让物资在需要的时候送达。"
	]
	quest.1752DF1046FD05B2.title: "第一道防线"
	quest.1752DF1046FD05B2.quest_desc: [
		"从照明、地形和安全通道开始，设置可以撤退的内外防线。为巡逻、补给和维修保留通道。"
		""
		"{\"text\":\"» 详见手册：怪潮工程兵\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6AD45769D44A5F98\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"怪潮工程兵\"}}"
