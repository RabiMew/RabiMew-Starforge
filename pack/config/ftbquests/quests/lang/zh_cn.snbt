	chapter.23F04414D2AFEB65.title: "军事防御"
	chapter.23F04414D2AFEB65.chapter_subtitle: [
		"规划防线与火力，用充足补给守住生产和生活空间。"
	]
	quest.061F44AAFD6FFC83.title: "发射前的工业准备"
	quest.061F44AAFD6FFC83.quest_desc: [
		"在地球生产航天材料和控制核心，准备燃料、氧气、食物与返航储备。先验证补给，再安排首航。"
	]
	quest.061F44AAFD6FFC83.quest_subtitle: "推荐阶段：原子时代"
	quest.7FA3F49803108CD1.title: "从工厂走向月球"
	quest.7FA3F49803108CD1.quest_desc: [
		"带上启动电源、氧气设备和基础建材，建立可以安全返回的月球前哨。外星采矿提高效率，但不是地球科技的必经之路。"
		""
