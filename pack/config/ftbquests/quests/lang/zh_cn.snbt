	quest.43727C69AA43A83C.title: "虫群压制"
	quest.43727C69AA43A83C.quest_desc: [
		"高射速与面杀伤 EOS 武器针对 Arachnids 虫群与大型怪潮。压制力强，但持续开火会快速烧穿弹药库存。"
		""
		"{\"text\":\"» 详见手册：晨曦女神实验室武器定位\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"60BD0CCFC3034959\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"晨曦女神实验室武器定位\"}}"
	]
	quest.43727C69AA43A83C.quest_subtitle: "推荐阶段：原子时代"
	quest.09D27335218273DA.title: "远征火力"
	quest.09D27335218273DA.quest_desc: [
		"为外星探索准备重型火力与足量弹药储备：外星高危目标与返程断供都靠这一层兜底。"
		""
