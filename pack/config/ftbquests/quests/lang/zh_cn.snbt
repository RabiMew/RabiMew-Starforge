	quest.7FD9F6B5176631DF.title: "建设轨道中转站"
	quest.7FD9F6B5176631DF.quest_desc: [
		"把空间站建成安全仓储、科研和转运节点。默认不会出现敌人，仍需维持氧气与电力；特殊事件只在明确开启后发生。"
		""
		"{\"text\":\"» 详见手册：安全空间站\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4B5A9C30A8FBCA52\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"安全空间站\"}}"
	]
	quest.7FD9F6B5176631DF.quest_subtitle: "推荐阶段：太空时代"
	quest.0E6767E1E6DA1ED6.title: "让殖民地能够自治"
	quest.0E6767E1E6DA1ED6.quest_desc: [
		"为各据点建立本地库存、供电、温室、居民区和驻军防线。按各星球的优势分工，比较运输与防御成本后再扩大产能。"
		""
		"{\"text\":\"» 详见手册：轻量殖民地\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5D67189820FB07DC\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"轻量殖民地\"}}"
		"{\"text\":\"» 详见手册：殖民居民\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6FBF02C8FB016AC6\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"殖民居民\"}}"
	]
	quest.0E6767E1E6DA1ED6.quest_subtitle: "推荐阶段：太空时代"
	quest.0AF6F16EA4174410.title: "航天便利装备"
	quest.0AF6F16EA4174410.quest_desc: [
		"氧气罐、燃料装载机、火箭传感器与重力调节器改善航天基地的日常运转。环境附魔手册仍需对应星球的材料，不替代氧气与燃料系统。"
		""
		"{\"text\":\"» 详见手册：航天便利装备\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"344ED9F136392B5D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"航天便利装备\"}}"
	]
	quest.0AF6F16EA4174410.quest_subtitle: "推荐阶段：太空时代"
	quest.16E992F88F58E687.title: "前往小行星带"
	quest.16E992F88F58E687.quest_desc: [
		"小行星带没有可以正常降落的地面：火箭可能在真空中丢失，氧气为零且没有救援。备好返航手段与补给后再出发，把第一次航行当作侦察而非采矿。"
		""
		"{\"text\":\"» 详见手册：小行星带风险\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2BFD78A0764A92FF\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"小行星带风险\"}}"
	]
	quest.16E992F88F58E687.quest_subtitle: "推荐阶段：太空时代"
	quest.52A6CBDE7280FA89.title: "小行星采矿作业"
	quest.52A6CBDE7280FA89.quest_desc: [
		"漂浮的矿岩富含铁、铜、金与少量宝石，密度远高于行星矿脉。规划锚点、照明与回收路线，用货运运力把高风险换成稳定产出。"
		""
		"{\"text\":\"» 详见手册：小行星带风险\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2BFD78A0764A92FF\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"小行星带风险\"}}"
	]
	quest.52A6CBDE7280FA89.quest_subtitle: "推荐阶段：太空时代"
	quest.125E01F71BB1770C.title: "火箭装配间"
	quest.125E01F71BB1770C.quest_desc: [
		"NASA 工作台、发射台与尾翼备齐——火箭开始总装。发射场选址记得留足净空。"
		""
		"{\"text\":\"» 详见手册：航天便利装备\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"344ED9F136392B5D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"航天便利装备\"}}"
	]
	quest.125E01F71BB1770C.quest_subtitle: "推荐阶段：太空时代"
	quest.31E14278C99F13AB.title: "燃料加注链"
	quest.31E14278C99F13AB.quest_desc: [
		"炼油厂出燃料、加注机喂火箭：发射不再靠手拎桶。这条链同时也是石油经济的终段。"
		""
		"{\"text\":\"» 详见手册：统一石油经济\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1932C9CEA2E264BB\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"统一石油经济\"}}"
	]
	quest.31E14278C99F13AB.quest_subtitle: "推荐阶段：太空时代"
	quest.56FE663A93DD6F1A.title: "月面落点"
	quest.56FE663A93DD6F1A.quest_desc: [
		"在月球插下第一面旗——轨道之外的第一站，也是检验氧气与返程储备的试金石。"
	]
	quest.56FE663A93DD6F1A.quest_subtitle: "推荐阶段：太空时代"
	quest.3FDFA2A65CA97C91.title: "火星远征"
	quest.3FDFA2A65CA97C91.quest_desc: [
		"抵达火星：戴斯矿脉与第二个永久殖民点。去之前把氧气、燃料与返航方案各备一份冗余。"
	]
	quest.3FDFA2A65CA97C91.quest_subtitle: "推荐阶段：太空时代"
	quest.04089907F6DAA567.title: "生命维持"
	quest.04089907F6DAA567.quest_desc: [
		"制氧机、输氧端、抽水泵上线——站点从「能落脚」变成「能住人」。殖民地扩张的先决条件。"
		""
		"{\"text\":\"» 详见手册：安全空间站\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4B5A9C30A8FBCA52\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"安全空间站\"}}"
	]
	quest.04089907F6DAA567.quest_subtitle: "推荐阶段：太空时代"
	quest.7EFD6B90AAB0B745.title: "低重力作战"
	quest.7EFD6B90AAB0B745.quest_desc: [
		"低重力下后坐力、跳跃与坠落完全不同。在外星地表完成一次武器实射并记录差异。"
		""
		"{\"text\":\"» 详见手册：低重力与外星战斗\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"46C8EE9AF7A2DC7E\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"低重力与外星战斗\"}}"
	]
	quest.7EFD6B90AAB0B745.quest_subtitle: "推荐阶段：太空时代"
	quest.01A8A31E7CBB6ACA.title: "返航补给"
	quest.01A8A31E7CBB6ACA.quest_desc: [
		"每次远征必须留足返航燃料、氧气和食物。把\"返回储备\"当作硬性载荷，不得挪用。"
		""
		"{\"text\":\"» 详见手册：远征背包配置\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D8C96A7B6F83F18\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"远征背包配置\"}}"
		"{\"text\":\"» 详见手册：航天便利装备\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"344ED9F136392B5D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"航天便利装备\"}}"
	]
	quest.01A8A31E7CBB6ACA.quest_subtitle: "推荐阶段：太空时代"
	quest.2297FE3FCEB77ECA.title: "行星侦察"
	quest.2297FE3FCEB77ECA.quest_desc: [
		"每个天体都有不同的重力、温度、辐射与战利品。登陆前先完成侦察清单再下货。"
		""
		"{\"text\":\"» 详见手册：外星结构与考古\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"706640814E58980D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"外星结构与考古\"}}"
		"{\"text\":\"» 详见手册：生物生态调查\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BE0F716B792B7F8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"生物生态调查\"}}"
	]
	quest.2297FE3FCEB77ECA.quest_subtitle: "推荐阶段：太空时代"
	chapter.7A1F8F3DD46D426E.title: "航天殖民"
	chapter.7A1F8F3DD46D426E.chapter_subtitle: [
		"规划航行、氧气和补给，把远方据点建设成稳定的生产基地。"
	]
	quest.5CFC818ECAF2A1E1.title: "带着目标勘察"
	quest.5CFC818ECAF2A1E1.quest_desc: [
		"记录矿点、道路、地形和潜在据点。勘察成果帮助工程与建筑选址，无需通过战斗证明价值。"
	]
	quest.5CFC818ECAF2A1E1.quest_subtitle: "推荐阶段：生存时代"
	quest.2E3803EB5B7C3AB1.title: "把遗迹变成工业捷径"
	quest.2E3803EB5B7C3AB1.quest_desc: [
		"回收可用材料、模板和蓝图。它们能节省工厂投入，但同类基础功能始终保留确定性的制造途径。"
	]
	quest.2E3803EB5B7C3AB1.quest_subtitle: "推荐阶段：信息时代"
	quest.6B02183287572A0A.title: "挑战高危遗迹"
	quest.6B02183287572A0A.quest_desc: [
		"自行选择是否挑战遗迹首领。准备撤离路线和补给，争取高价值材料或特殊模块；胜利不解锁必需科技。"
	]
	quest.6B02183287572A0A.quest_subtitle: "推荐阶段：太空时代"
	quest.33F96CADFA9891F7.title: "调查外星异常"
	quest.33F96CADFA9891F7.quest_desc: [
		"先观察异常预警，再决定采样或撤离。把回收成果交给工业与科研设施处理，不将未知样本直接带入生活舱。"
	]
	quest.33F96CADFA9891F7.quest_subtitle: "推荐阶段：太空时代"
	quest.17108BC68E5E17B5.title: "勘察外星结构"
	quest.17108BC68E5E17B5.quest_desc: [
		"行星表面的废墟与高塔藏有补给，也有原生个体的刷怪笼。战利品按星球强度分级，但任何发现都不能替代工业制造。"
	]
	quest.17108BC68E5E17B5.quest_subtitle: "推荐阶段：太空时代"
	quest.5FB2C68FD35C744B.title: "搜集外星遗物饰品"
	quest.5FB2C68FD35C744B.quest_desc: [
		"Artifacts 饰品只可通过探索获得。地球遗迹与营地出产基础便利饰品；月球/火星遗迹藏有生存与探索辅助；金星/水星遗迹藏有战斗与防御饰品；Glacio 遗迹与小行星带藏有最稀有遗物。强力饰品不替代氧气、宇航服与火箭等级。"
	]
	quest.5FB2C68FD35C744B.quest_subtitle: "推荐阶段：太空时代"
	quest.7B5BD275BEF97E3E.title: "远征行装"
	quest.7B5BD275BEF97E3E.quest_desc: [
		"罗盘、地图与火把：出门探索的三件套。背包进阶用法见手册《背包与远征物资》。"
		""
		"{\"text\":\"» 详见手册：背包与远征物资\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"28C9F6D61C4E55C2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"背包与远征物资\"}}"
	]
	quest.7B5BD275BEF97E3E.quest_subtitle: "推荐阶段：生存时代"
	quest.0B6E927FD2CC7D1B.title: "下界侦察"
	quest.0B6E927FD2CC7D1B.quest_desc: [
		"穿过下界门侦察一圈：石英、烈焰棒与菌光体都值得标记。快进快出，别贪。"
	]
	quest.0B6E927FD2CC7D1B.quest_subtitle: "推荐阶段：机械时代"
	quest.76B7ECD689453090.title: "陨石研究"
	quest.76B7ECD689453090.quest_desc: [
		"充能器点亮陨石晶体，氟露英水晶开始批量产出——这是数字网络的原料命脉。"
	]
	quest.76B7ECD689453090.quest_subtitle: "推荐阶段：信息时代"
	quest.3337DD355D021D68.title: "第一件遗物"
	quest.3337DD355D021D68.quest_desc: [
		"遗迹与战利品箱会产出 Artifacts 遗物饰品。获得任意一件并装到 Curios 栏位——不同的栏位对应不同部位。"
		""
		"{\"text\":\"» 详见手册：Artifacts 与 Curios 栏位\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"215A050EB8A4CB9C\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Artifacts 与 Curios 栏位\"}}"
	]
	quest.3337DD355D021D68.quest_subtitle: "推荐阶段：生存时代"
	quest.44DA18379651CDA7.title: "月火遗物"
	quest.44DA18379651CDA7.quest_desc: [
		"月球与火星的遗迹产出第二档遗物。带回任意一件月/火档位遗物即可。"
		""
		"{\"text\":\"» 详见手册：Artifacts 与 Curios 栏位\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"215A050EB8A4CB9C\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Artifacts 与 Curios 栏位\"}}"
		"{\"text\":\"» 详见手册：外星结构与考古\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"706640814E58980D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"外星结构与考古\"}}"
	]
	quest.44DA18379651CDA7.quest_subtitle: "推荐阶段：太空时代"
	quest.6032F578C5F37DB7.title: "高危遗物"
	quest.6032F578C5F37DB7.quest_desc: [
		"金星与水星的高温高压环境藏着第三档遗物。准备充分再进入，带回任意一件即可。"
		""
		"{\"text\":\"» 详见手册：Artifacts 与 Curios 栏位\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"215A050EB8A4CB9C\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Artifacts 与 Curios 栏位\"}}"
		"{\"text\":\"» 详见手册：外星结构与考古\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"706640814E58980D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"外星结构与考古\"}}"
	]
	quest.6032F578C5F37DB7.quest_subtitle: "推荐阶段：太空时代"
	quest.0CB50C41FBCD2682.title: "边疆遗物"
	quest.0CB50C41FBCD2682.quest_desc: [
		"冰巨星与小行星带是遗物猎人的终点：稀有遗物只在最远处出现。无需集齐图鉴，带回任意一件即可。"
		""
		"{\"text\":\"» 详见手册：Artifacts 与 Curios 栏位\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"215A050EB8A4CB9C\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"Artifacts 与 Curios 栏位\"}}"
		"{\"text\":\"» 详见手册：外星结构与考古\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"706640814E58980D\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"外星结构与考古\"}}"
	]
	quest.0CB50C41FBCD2682.quest_subtitle: "推荐阶段：太空时代"
	quest.14C1933433AE2931.title: "生态调查"
	quest.14C1933433AE2931.quest_desc: [
		"记录地表与地下的异常生物：末影人变体、蛛形纲群落、洞穴特有种。一本笔记就够，不必猎光它们。"
		""
		"{\"text\":\"» 详见手册：生物生态调查\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BE0F716B792B7F8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"生物生态调查\"}}"
	]
	quest.14C1933433AE2931.quest_subtitle: "推荐阶段：机械时代"
	quest.754414537A314DA3.title: "蛛群威胁"
	quest.754414537A314DA3.quest_desc: [
		"蛛形纲战士会破坏防线外围。猎杀 3 只蛛形纲战士，确认其群落位置。"
		""
		"{\"text\":\"» 详见手册：生物生态调查\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BE0F716B792B7F8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"生物生态调查\"}}"
	]
	quest.754414537A314DA3.quest_subtitle: "推荐阶段：机械时代"
	quest.12E6FEFAE5AD67A7.title: "外星生态"
	quest.12E6FEFAE5AD67A7.quest_desc: [
		"月球与火星的原生物种遵循完全不同的规则。记录至少一种外星物种的栖息地。"
		""
		"{\"text\":\"» 详见手册：生物生态调查\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6BE0F716B792B7F8\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"生物生态调查\"}}"
	]
	quest.12E6FEFAE5AD67A7.quest_subtitle: "推荐阶段：太空时代"
	chapter.637830D327841CC8.title: "探索"
	chapter.637830D327841CC8.chapter_subtitle: [
		"调查遗迹与异常，带回资源、蓝图和工业捷径。"
	]
	quest.7C549AB52654538C.title: "一座能供餐的厨房"
	quest.7C549AB52654538C.quest_desc: [
		"建立农田、烹饪锅和集中厨房，准备碗与基础燃料。让队友方便取得食物，而不是各自反复寻找原料。"
		""
		"{\"text\":\"» 详见手册：厨房自动化\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B1F9252FB11EAD5\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"厨房自动化\"}}"
	]
	quest.7C549AB52654538C.quest_subtitle: "推荐阶段：生存时代"
	quest.091668F16A21A35F.title: "把收成送到需要的地方"
	quest.091668F16A21A35F.quest_desc: [
		"连接农场、厨房和远征补给箱，预留主粮库存。检查容器回收和满仓情况，让运输保持稳定。"
		""
		"{\"text\":\"» 详见手册：厨房自动化\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B1F9252FB11EAD5\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"厨房自动化\"}}"
	]
	quest.091668F16A21A35F.quest_subtitle: "推荐阶段：机械时代"
	quest.6B7786C4146F1A73.title: "食堂优先，余粮供能"
	quest.6B7786C4146F1A73.quest_desc: [
		"用农产支撑生物燃料生产，先保证厨房与种子的库存。工业扩张时同步规划种植规模，避免燃料线耗尽食物。"
		""
		"{\"text\":\"» 详见手册：统一石油经济\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"1932C9CEA2E264BB\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"统一石油经济\"}}"
	]
	quest.6B7786C4146F1A73.quest_subtitle: "推荐阶段：重工业时代"
	quest.39AD03268D0C83AE.title: "在外星种下第一片农田"
	quest.39AD03268D0C83AE.quest_desc: [
		"为月球或火星农场准备密封、供氧、光照、水和备用电。先验证环境与作物适应性，再扩大生产。"
	]
	quest.39AD03268D0C83AE.quest_subtitle: "推荐阶段：太空时代"
	quest.60EC892D396AFC26.title: "开垦农田"
	quest.60EC892D396AFC26.quest_desc: [
		"种下第一片麦田并围好护栏：厨房有了稳定原料，怪潮夜也饿不着人。"
		""
		"{\"text\":\"» 详见手册：厨房自动化\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3B1F9252FB11EAD5\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"厨房自动化\"}}"
	]
	quest.60EC892D396AFC26.quest_subtitle: "推荐阶段：生存时代"
	quest.6E99CCD7093D32CF.title: "牧场启动"
	quest.6E99CCD7093D32CF.quest_desc: [
		"养殖棚与农夫装置上线：食物来源不再只靠田，皮革、羽毛、肥料一并进账。"
	]
	quest.6E99CCD7093D32CF.quest_subtitle: "推荐阶段：机械时代"
	quest.76B18E56A2AF597A.title: "季节储备"
	quest.76B18E56A2AF597A.quest_desc: [
		"为远征与怪潮季单列一座干粮仓：罐头、饼干与备份种子，平时不动、急时救命。"
	]
	quest.76B18E56A2AF597A.quest_subtitle: "推荐阶段：电气时代"
	quest.5C08D931A3082653.title: "集中储粮"
	quest.5C08D931A3082653.quest_desc: [
		"大宗食物与原料进抽屉，厨房只留高频取用量。抽屉存散料，仓库放杂货。"
		""
		"{\"text\":\"» 详见手册：仓储分层\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5FBDC2FE9BA6964E\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"仓储分层\"}}"
	]
	quest.5C08D931A3082653.quest_subtitle: "推荐阶段：机械时代"
	quest.46642DBD06A70ABC.title: "基地厨房网络"
	quest.46642DBD06A70ABC.quest_desc: [
		"烹饪台、水槽与台面构成厨房网络：烹饪台直接读取相连容器里的食材。把冰箱和台面接进同一网络。"
		""
		"{\"text\":\"» 详见手册：CFB 厨房网络\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"73E35DDDFAD2E809\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"CFB 厨房网络\"}}"
	]
	quest.46642DBD06A70ABC.quest_subtitle: "推荐阶段：生存时代"
	quest.69AE0F6EE8647B0F.title: "工业供热"
	quest.69AE0F6EE8647B0F.quest_desc: [
		"电力燃烧器为厨房与食品产线提供稳定热源，替代木柴与煤炭的间歇补给。"
		""
		"{\"text\":\"» 详见手册：CFB 厨房网络\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"73E35DDDFAD2E809\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"CFB 厨房网络\"}}"
	]
	quest.69AE0F6EE8647B0F.quest_subtitle: "推荐阶段：电气时代"
	quest.3909E0CC792F88C2.title: "食品自动补货"
	quest.3909E0CC792F88C2.quest_desc: [
		"让物流或 ME 网络按库存水位自动补充厨房原料，厨师只管出餐。"
		""
		"{\"text\":\"» 详见手册：应用烹饪与数字厨房\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0A70E891FF739F21\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"应用烹饪与数字厨房\"}}"
	]
	quest.3909E0CC792F88C2.quest_subtitle: "推荐阶段：信息时代"
	quest.404A138A10525F39.title: "ME 食品网络"
	quest.404A138A10525F39.quest_desc: [
		"Applied Cooking 的厨房工作站与 Applied Delight 的 ME 炊具把食品生产挂进数字网络，按需合成。"
		""
		"{\"text\":\"» 详见手册：应用烹饪与数字厨房\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0A70E891FF739F21\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"应用烹饪与数字厨房\"}}"
	]
	quest.404A138A10525F39.quest_subtitle: "推荐阶段：信息时代"
	quest.72AC6BB895B11A07.title: "殖民地配餐"
	quest.72AC6BB895B11A07.quest_desc: [
		"外星居住舱与温室接入食品网络后，殖民地居民的配餐由系统统一调度，不再靠人背粮。"
		""
		"{\"text\":\"» 详见手册：应用烹饪与数字厨房\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0A70E891FF739F21\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"应用烹饪与数字厨房\"}}"
		"{\"text\":\"» 详见手册：轻量殖民地\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"5D67189820FB07DC\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"轻量殖民地\"}}"
	]
	quest.72AC6BB895B11A07.quest_subtitle: "推荐阶段：太空时代"
	quest.2EDC7790CF384594.title: "现代厨房"
	quest.2EDC7790CF384594.quest_desc: [
		"厨房抽屉与炉灶把储藏室变成真正的厨房。Refurbished 的储物方块会原生接入 CFB 厨房网络。"
		""
		"{\"text\":\"» 详见手册：现代厨房\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0E9D6B40063DF60A\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"现代厨房\"}}"
	]
	quest.2EDC7790CF384594.quest_subtitle: "推荐阶段：机械时代"
	quest.123AEA037FB67BAE.title: "工业食品加工"
	quest.123AEA037FB67BAE.quest_desc: [
		"制作钢制屠宰刀，把 IE 机器开进食品产线：园艺玻璃罩量产作物、冲压机绞肉、挤压机榨汁。这把刀是 Engineers Delight 配方的入场券。"
		""
		"{\"text\":\"» 详见手册：工业食品加工\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7AAC1E5061A9C042\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"工业食品加工\"}}"
	]
	quest.123AEA037FB67BAE.quest_subtitle: "推荐阶段：电气时代"
	quest.47A9DB924B7F855C.title: "自动化食品工厂"
	quest.47A9DB924B7F855C.quest_desc: [
		"组装 Immersive Cooking 多方块：烹饪锅与发酵罐撑起批量烹饪与发酵产线，产出直接喂给 ME 仓储。"
		""
		"{\"text\":\"» 详见手册：食品自动化\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7B0CAA52B3E70CE4\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"食品自动化\"}}"
	]
	quest.47A9DB924B7F855C.quest_subtitle: "推荐阶段：重工业时代"
	chapter.4274BFE7FD246AAF.title: "农业与后勤"
	chapter.4274BFE7FD246AAF.chapter_subtitle: [
		"供应食物、农产和生物燃料，保障工厂、前线与殖民地。"
	]
	quest.67D80191074CCF3A.title: "给工厂留下成长空间"
	quest.67D80191074CCF3A.quest_desc: [
		"规划车间、仓库、管廊与检修通道。先搭出容易扩建的布局，再安排外观和装饰；不要求提交固定数量的方块。"
	]
	quest.67D80191074CCF3A.quest_subtitle: "推荐阶段：生存时代"
	quest.6EB064B477848BC2.title: "用工业工具扩大施工"
	quest.6EB064B477848BC2.quest_desc: [
		"制作基础建造工具，准备电池与建筑材料。先在小范围验证放置与撤销，再用于厂房和道路。"
	]
	quest.6EB064B477848BC2.quest_subtitle: "推荐阶段：电气时代"
	quest.5CD5CEBA5468B347.title: "建设可维护的工业区"
	quest.5CD5CEBA5468B347.quest_desc: [
		"用钢架、混凝土、玻璃与标识统一厂区，区分供电、生产和储备空间。保证防线射界及维修通道，外观不代替实际防护。"
	]
	quest.5CD5CEBA5468B347.quest_subtitle: "推荐阶段：重工业时代"
	quest.26EC2B4817F9C25D.title: "让殖民建筑服务生存"
	quest.26EC2B4817F9C25D.quest_desc: [
		"为生活舱、温室、机房和隔离区分舱，设置清晰路线与应急储备。检查真实气密性，不能仅凭玻璃外观判断安全。"
		""
		"{\"text\":\"» 详见手册：三层防御\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"482CA592DE6BAB84\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"三层防御\"}}"
	]
	quest.26EC2B4817F9C25D.quest_subtitle: "推荐阶段：太空时代"
	quest.40DFD7A80A1BED57.title: "建材批量"
	quest.40DFD7A80A1BED57.quest_desc: [
		"混凝土与玻璃量产入池：厂区扩建、殖民建筑、防御工事都从这一仓出料。"
	]
	quest.40DFD7A80A1BED57.quest_subtitle: "推荐阶段：机械时代"
	quest.751DE25742D71D15.title: "换置与复制"
	quest.751DE25742D71D15.quest_desc: [
		"换置小工具改材质、复制小工具铺结构——大型厂区与重复单元的建造提速一个量级。"
	]
	quest.751DE25742D71D15.quest_subtitle: "推荐阶段：重工业时代"
	quest.13129660D86A5A69.title: "拆除重建"
	quest.13129660D86A5A69.quest_desc: [
		"拆除小工具安全清场：旧区改造、事故处理、地形修正都不再靠手拆。"
	]
	quest.13129660D86A5A69.quest_subtitle: "推荐阶段：原子时代"
	quest.33137A5834F5A967.title: "休整区"
	quest.33137A5834F5A967.quest_desc: [
		"给基地划一块远离机器轰鸣的休整区：床、照明、简易家具。生活区与工业区分开，守卫和居民才有状态。"
		""
		"{\"text\":\"» 详见手册：宜居基地\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D4CAFB9EC9E6AC2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"宜居基地\"}}"
	]
	quest.33137A5834F5A967.quest_subtitle: "推荐阶段：生存时代"
	quest.7DE5C11A0F9E6A2B.title: "餐厅"
	quest.7DE5C11A0F9E6A2B.quest_desc: [
		"餐厅紧邻厨房网络：长桌、座椅、取餐口。让食物的最后一站离人最近。"
		""
		"{\"text\":\"» 详见手册：宜居基地\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D4CAFB9EC9E6AC2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"宜居基地\"}}"
		"{\"text\":\"» 详见手册：CFB 厨房网络\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"73E35DDDFAD2E809\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"CFB 厨房网络\"}}"
	]
	quest.7DE5C11A0F9E6A2B.quest_subtitle: "推荐阶段：生存时代"
	quest.3A9395C0631B98F1.title: "居民生活区"
	quest.3A9395C0631B98F1.quest_desc: [
		"居民需要成套的生活单元：床、储物、工作台位、照明分区。Macaw 与 Refurbished 家具负责生活质感。"
		""
		"{\"text\":\"» 详见手册：宜居基地\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D4CAFB9EC9E6AC2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"宜居基地\"}}"
	]
	quest.3A9395C0631B98F1.quest_subtitle: "推荐阶段：机械时代"
	quest.18BFCE7EDAE35FD1.title: "外星居住舱"
	quest.18BFCE7EDAE35FD1.quest_desc: [
		"外星前哨的居住舱要密封、供氧、独立供电，按\"生存舱+工作舱+气闸\"的三段式搭建。"
		""
		"{\"text\":\"» 详见手册：宜居基地\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0D4CAFB9EC9E6AC2\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"宜居基地\"}}"
	]
	quest.18BFCE7EDAE35FD1.quest_subtitle: "推荐阶段：太空时代"
	quest.4544E4D977AE36CB.title: "现代生活"
	quest.4544E4D977AE36CB.quest_desc: [
		"Refurbished 家具把基地变成家：座椅、桌子、沙发、整体橱柜、灯具和储物件。家具本身是装饰，通电后才活过来。"
		""
		"{\"text\":\"» 详见手册：现代生活\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7768292ADEE8BE72\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"现代生活\"}}"
	]
	quest.4544E4D977AE36CB.quest_subtitle: "推荐阶段：机械时代"
	quest.4B1C27A3F2032C31.title: "家用供电"
	quest.4B1C27A3F2032C31.quest_desc: [
		"Energized Furniture 的能源变压器把公共电网的 FE 接入 Refurbished 家庭电网。给房子接上电网。"
		""
		"{\"text\":\"» 详见手册：家用供电\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"3D52D8EF523B1359\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"家用供电\"}}"
	]
	quest.4B1C27A3F2032C31.quest_subtitle: "推荐阶段：电气时代"
	quest.4A11931A05ECF04F.title: "智能家居"
	quest.4A11931A05ECF04F.quest_desc: [
		"放置电脑并通过变压器供电，打开 Home Control 与 Starforge 新增应用即可监控基地。"
		""
		"{\"text\":\"» 详见手册：智能家居\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"53235BFFFF0D5717\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"智能家居\"}}"
	]
	quest.4A11931A05ECF04F.quest_subtitle: "推荐阶段：电气时代"
	chapter.56F4CC5F9343242B.title: "建筑"
	chapter.56F4CC5F9343242B.chapter_subtitle: [
		"建设便于扩展、维护与防守的工厂、基地和空间站。"
	]
	quest.306787D7CF3A4AAE.title: "团队进度与个人专精"
	quest.306787D7CF3A4AAE.quest_desc: [
		"团队共享制造研究，个人可以专精不同路线。买到成品不会自动获得制造权限；任务书只提供指引。"
	]
	quest.306787D7CF3A4AAE.quest_subtitle: "进度与生存"
	quest.6B23A0DB3D268796.title: "地球自给路线"
	quest.6B23A0DB3D268796.quest_desc: [
		"大部分基础资源和必需高级材料都能在地球获得。外星殖民节省原料与能源，探索提供捷径，但两者都不是继续工业的强制门槛。"
	]
	quest.6B23A0DB3D268796.quest_subtitle: "进度与生存"
	quest.08F61C4EED508F67.title: "电力优先级"
	quest.08F61C4EED508F67.quest_desc: [
		"先保氧气、应急电池和基础防线，再供应食堂与生产设备。把关键设施与高耗能机器分开，断电时保留本地储备。"
	]
	quest.08F61C4EED508F67.quest_subtitle: "能源·石油·网络"
	quest.79F690776849AD03.title: "AE2 冷启动"
	quest.79F690776849AD03.quest_desc: [
		"压印机先用独立电源运行，完成处理器后再建控制器。数字网络通过存储总线读取抽屉与仓储控制器；FastPipes 管网继续承担外围大宗运输，数字层负责调度与合成。"
	]
	quest.79F690776849AD03.quest_subtitle: "能源·石油·网络"
	quest.4B5A9C30A8FBCA52.title: "安全空间站"
	quest.4B5A9C30A8FBCA52.quest_desc: [
		"空间站默认没有敌对生成，但仍需生命保障。只有明确开启的特殊事件可以产生敌人；把隔离区与生活舱分开。"
	]
	quest.4B5A9C30A8FBCA52.quest_subtitle: "航天与风险"
	quest.3B1F9252FB11EAD5.title: "厨房自动化"
	quest.3B1F9252FB11EAD5.quest_desc: [
		"厨房集中取料，烹饪锅负责其支持的菜肴。先验证进出料方向、碗和燃料回收，再连接自动补货；余粮制燃料前先保留食物库存。"
	]
	quest.3B1F9252FB11EAD5.quest_subtitle: "进度与生存"
	quest.6AD45769D44A5F98.title: "怪潮工程兵"
	quest.6AD45769D44A5F98.quest_desc: [
		"工程兵能在有限范围拆除障碍或搭建通道。用多层防线、清晰射界和维修储备应对，优先处理正在开路的单位。"
	]
	quest.6AD45769D44A5F98.quest_subtitle: "怪潮与防御"
	quest.453A61A0B4D9C159.title: "仓储成长路线"
	quest.453A61A0B4D9C159.quest_desc: [
		"箱子与木桶之后，先用抽屉和通用仓储收大宗散料。容量、过滤和压缩升级随电气时代开放，并消耗工业部件。数字网络建成后读取现有仓库，而不是取代它们。"
	]
	quest.453A61A0B4D9C159.quest_subtitle: "进度与生存"
	quest.0E8B4E397AC0FBCA.title: "统一管网：FastPipes"
	quest.0E8B4E397AC0FBCA.quest_desc: [
		"FastPipes 是整合包默认通用管网：物品、流体与 FE 电力共用一套管道。抽取附件从容器与机器取货，带过滤、红石控制与分流模式；输入附件标记投递优先级；传感器/虚空附件负责信号与满仓处理；终端把管网变成可检索的小仓库。IE 传送带与流体管保留作可视化工业产线；BuildCraft 管道仅留作采石场、泵等 BC 特色设备周边的老式方案；Railcraft 管跨区大宗货运；AE2 管数字仓储与自动合成，不承担普通管道职责。供电走 FE 公共电网：FastPipes 能源管道直连 IE、Ad Astra、IC2CRE（原生 FE 端口）与 Railcraft 电力设备；BuildCraft 用自带 FE 引擎与 MJ 发电机互转；Refurbished 家电经能源变压器接入。"
	]
	quest.0E8B4E397AC0FBCA.quest_subtitle: "能源·石油·网络"
	quest.28C9F6D61C4E55C2.title: "背包与远征物资"
	quest.28C9F6D61C4E55C2.quest_desc: [
		"背包承担采矿、工程、探索、远征和殖民施工的随身补给。基础背包较早可用；容量、自动拾取和补给升级随阶段开放。背包不代替工厂物流，也不是随身合成网络。"
	]
	quest.28C9F6D61C4E55C2.quest_subtitle: "进度与生存"
	quest.1932C9CEA2E264BB.title: "统一石油经济"
	quest.1932C9CEA2E264BB.quest_desc: [
		"油田经 FastPipes 流体管进入统一石油链：石油工业精炼、电气控制和重工业加工产出燃料与化工品，供发电、防务和航天使用。两套产油设备以同一流体和标签互认为准。"
	]
	quest.1932C9CEA2E264BB.quest_subtitle: "能源·石油·网络"
	quest.5D67189820FB07DC.title: "轻量殖民地"
	quest.5D67189820FB07DC.quest_desc: [
		"殖民地是工业前哨加少量居民、警卫与炮塔，不是城市模拟。工业养活殖民地，军工武装守卫，守卫与炮塔保护工业。"
	]
	quest.5D67189820FB07DC.quest_subtitle: "殖民人口与驻军"
	quest.6FBF02C8FB016AC6.title: "殖民居民"
	quest.6FBF02C8FB016AC6.quest_desc: [
		"第一批居民从地球招募并随火箭抵达。用殖民设施承接人口：农业设施供餐、居住中心扩展人口、贸易设施交换物资。"
	]
	quest.6FBF02C8FB016AC6.quest_subtitle: "殖民人口与驻军"
	quest.4C0A7C642219B0D2.title: "殖民警卫"
	quest.4C0A7C642219B0D2.quest_desc: [
		"警卫负责巡逻、建筑内部防守和炮塔死角。用工业制造的枪械与护甲武装他们；普通居民在怪潮中躲避而非参战。"
	]
	quest.4C0A7C642219B0D2.quest_subtitle: "殖民人口与驻军"
	quest.15C288AF8333C644.title: "殖民军械"
	quest.15C288AF8333C644.quest_desc: [
		"枪械制造接入工业链：精炼金属、冲压零件、化工发射药。按普通警卫、射手、重装与支援区分装备，不给每个守卫发终局装备。"
	]
	quest.15C288AF8333C644.quest_subtitle: "殖民人口与驻军"
	quest.4C15617E8C8DA7F9.title: "弹药后勤"
	quest.4C15617E8C8DA7F9.quest_desc: [
		"弹药消耗进入工业经济：弹头、弹壳与发射药都来自产线。为步兵建立独立弹药库存，守卫会从附近箱子取用。"
	]
	quest.4C15617E8C8DA7F9.quest_subtitle: "殖民人口与驻军"
	quest.744853EABC0E1648.title: "殖民地补给链"
	quest.744853EABC0E1648.quest_desc: [
		"补给链保留本地缓冲：主库存按阈值补货，实体物流送到前线弹药箱。网络中断时，驻军依靠本地库存继续战斗。"
	]
	quest.744853EABC0E1648.quest_subtitle: "殖民人口与驻军"
	quest.482CA592DE6BAB84.title: "三层防御"
	quest.482CA592DE6BAB84.quest_desc: [
		"三层防御各司其职：炮塔守外围与主火力线，警卫守建筑内部与死角，玩家处理精英、工程兵与战线破口。"
	]
	quest.482CA592DE6BAB84.quest_subtitle: "怪潮与防御"
	quest.1630974DE79170F7.title: "殖民地防御压力"
	quest.1630974DE79170F7.quest_desc: [
		"殖民地的怪潮靠战术、数量和特殊单位施压，而不是给普通怪堆血量。保持弹药、电力、食物与维修储备。"
	]
	quest.1630974DE79170F7.quest_subtitle: "怪潮与防御"
	quest.6D57B198ED6623C4.title: "基地防御分层"
	quest.6D57B198ED6623C4.quest_desc: [
		"防线按火力分层：IE 哨戒炮承担中前期固定防御；TACZ 自动炮塔承担中后期军用自动防御（装枪+弹药箱）；武装警卫是机动步兵；玩家处理高价值目标、工程抢修与防线崩溃。不要把鸡蛋放在同一个炮塔里。"
	]
	quest.6D57B198ED6623C4.quest_subtitle: "怪潮与防御"
	quest.2E55B63F9D911701.title: "自动炮塔：装枪与补给"
	quest.2E55B63F9D911701.quest_desc: [
		"TACZ 炮塔对玩家点击或掉落物装入一把 TaCZ 枪。弹药从它下方/相邻的箱子取用——这是“最后一公里物流”：FastPipes 与 AE2 负责把弹药箱填满，炮塔自己取弹。红黄绿状态灯分别提示换弹/缺弹/就绪。"
	]
	quest.2E55B63F9D911701.quest_subtitle: "怪潮与防御"
	quest.60BD0CCFC3034959.title: "晨曦女神实验室武器定位"
	quest.60BD0CCFC3034959.quest_desc: [
		"EOS 武器库是重型科幻层：高斯枪族（HG-57、AR-68、MG-85）、ELP 电浆系列（ELP-13 到 ELP-72）与特种军械（艾莲娜之钉、四叶十字、阿喀琉斯）。它们通过工业中间件分阶段解锁，弹药成本明显高于常规枪械。EOS 配方在 EOS 打印台上执行——用磨制深板岩、铁、铜与黄色玻璃合成该工作台。"
	]
	quest.60BD0CCFC3034959.quest_subtitle: "怪潮与防御"
	quest.725FD622502D6892.title: "警卫武器选择"
	quest.725FD622502D6892.quest_desc: [
		"Guard Villagers 可装备 TaCZ 枪械作战。只发可靠的常规武器：步枪、冲锋枪、霰弹枪。不要发爆炸物、AoE 或特殊机制武器——殖民地经不起误伤。"
	]
	quest.725FD622502D6892.quest_subtitle: "怪潮与防御"
	quest.009B2C59FE3D645E.title: "TaCZ Addon：枪匠助手"
	quest.009B2C59FE3D645E.quest_desc: [
		"TaCZ Addon 优化枪匠台体验：按枪过滤附件与弹药、查看材料清单、跳转 JEI 配方、批量合成，并可从邻近容器与背包取用材料。它只减少操作负担，不降低制造成本。"
	]
	quest.009B2C59FE3D645E.quest_subtitle: "怪潮与防御"
	quest.76E5B544AD6A0494.title: "外星远征弹药准备"
	quest.76E5B544AD6A0494.quest_desc: [
		"远征前按消耗率备货：常规武器按战斗时长×射速估算，EOS 武器额外准备重装弹药。量子桥接通主库存前，背包与弹药箱就是你的全部后勤。"
	]
	quest.76E5B544AD6A0494.quest_subtitle: "航天与风险"
	quest.4D5475C44C18F8A3.title: "各星球驻军"
	quest.4D5475C44C18F8A3.quest_desc: [
		"各星球驻军风格不同：火星靠炮塔扛高压虫群，霜原星需要穿甲火力，水星只留少量精锐。未加载的殖民地不消耗运算。"
	]
	quest.4D5475C44C18F8A3.quest_subtitle: "殖民人口与驻军"
	quest.64258511A9B2A6A2.title: "殖民岗位"
	quest.64258511A9B2A6A2.quest_desc: [
		"居民可在工作站领取岗位：农业、后勤、仓储、机械、电气、军械、网络、重工、生命保障与航天。岗位放大工业效率，但无人产线仍能完整运转。"
	]
	quest.64258511A9B2A6A2.quest_subtitle: "岗位与维护"
	quest.42C7021D8B191D18.title: "岗位分配"
	quest.42C7021D8B191D18.quest_desc: [
		"岗位绑定所属基地，不跨星球生效。同一产线的岗位收益边际递减；守卫是军事岗位，不兼任工业职位。"
	]
	quest.42C7021D8B191D18.quest_subtitle: "岗位与维护"
	quest.0B6171AAE7597875.title: "维护与收益"
	quest.0B6171AAE7597875.quest_desc: [
		"维护消耗工业材料换取效率与稳定：维护良好的产线略有增益，无人维护也不会停机或损坏。"
	]
	quest.0B6171AAE7597875.quest_subtitle: "岗位与维护"
	quest.4642427A4336C17F.title: "铁路物流"
	quest.4642427A4336C17F.quest_desc: [
		"铁路承担基地、矿区与星港之间的高吞吐运输：货运车厢装散料，罐车运液体，装卸机对接仓储。基地内部短距离交给 FastPipes 管网，数字网络负责调度而非取代铁路。"
	]
	quest.4642427A4336C17F.quest_subtitle: "铁路物流"
	quest.4BD992661353F0B8.title: "星港铁路"
	quest.4BD992661353F0B8.quest_desc: [
		"星港是铁路的终点而非替代：矿区列车进入分拣区，燃料与氧气经流体装车送达发射台。外星殖民地同样可以用铁路连接登陆区、矿场、氧气区与发射场。"
	]
	quest.4BD992661353F0B8.quest_subtitle: "铁路物流"
	quest.344ED9F136392B5D.title: "航天便利装备"
	quest.344ED9F136392B5D.quest_desc: [
		"氧气罐是便携储氧设备，燃料装载机自动为火箭加注，火箭传感器与重力调节器简化基地自动化。这些设备在太空时代开放，仍需真实材料制造。"
	]
	quest.344ED9F136392B5D.quest_subtitle: "航天与风险"
	quest.2BFD78A0764A92FF.title: "小行星带风险"
	quest.2BFD78A0764A92FF.quest_desc: [
		"小行星带是真空矿区：重力极低、没有氧气、没有天然落脚点。火箭降落失败可能永久损失，务必携带返航手段并预留火箭备份。"
	]
	quest.2BFD78A0764A92FF.quest_subtitle: "航天与风险"
	quest.215A050EB8A4CB9C.title: "Artifacts 与 Curios 栏位"
	quest.215A050EB8A4CB9C.quest_desc: [
		"遗物饰品装在 Curios 栏位而不是盔甲栏：项链、腰带、手套、头饰各有位置，鼠标悬停遗物会显示它属于哪一档（地球→月火→金水→冰巨星/小行星带）。高价值遗物都标了发现地点，拿到先用任务书查栏位再装备。"
	]
	quest.215A050EB8A4CB9C.quest_subtitle: "野外与遗迹"
	quest.706640814E58980D.title: "外星结构与考古"
	quest.706640814E58980D.quest_desc: [
		"月球与火星地表散布可探索结构：废弃基地、坠毁飞船、殖民遗迹。金星与水星结构更危险也更丰厚。进入任何外星结构前先确认氧气与返航燃料，带走箱子和方块数据即可，不必清剿。"
	]
	quest.706640814E58980D.quest_subtitle: "野外与遗迹"
	quest.6BE0F716B792B7F8.title: "生物生态调查"
	quest.6BE0F716B792B7F8.quest_desc: [
		"这个整合包的生物按生态位分布：Enderman Overhaul 的末影人按群系分化，Creature Feature 占据特殊洞穴与水层，Arachnids 结成蛛群，外星天体各有原生物种。调查时记录栖息地与行为，罕见个体不强求——图鉴不是考核。"
	]
	quest.6BE0F716B792B7F8.quest_subtitle: "野外与遗迹"
	quest.5FBDC2FE9BA6964E.title: "仓储分层"
	quest.5FBDC2FE9BA6964E.quest_desc: [
		"仓储按角色分层，不要混用：Storage Drawers 存大宗单一散料（矿锭、粮食、石材），压缩抽屉自动归并等级；Sophisticated Storage 负责杂项仓库与限量桶；Sophisticated Backpacks 管野战背包；AE2 负责数字索引与自动合成，FastPipes 管网/Railcraft 负责物理运输。抽屉进散料，桶柜进杂货，背包进背包，网络进索引。"
	]
	quest.5FBDC2FE9BA6964E.quest_subtitle: "进度与生存"
	quest.0D8C96A7B6F83F18.title: "远征背包配置"
	quest.0D8C96A7B6F83F18.quest_desc: [
		"背包按任务配置升级：野战探索带拾取+磁铁；战斗远征带堆叠+补给；远征外星再塞氧气罐与口粮包。背包栏位可与 Curios 并用——检查快捷键，把备用弹匣放进专门的弹匣袋。"
	]
	quest.0D8C96A7B6F83F18.quest_subtitle: "进度与生存"
	quest.0D4CAFB9EC9E6AC2.title: "宜居基地"
	quest.0D4CAFB9EC9E6AC2.quest_desc: [
		"把基地分成工业区与生活区：机器与产线集中管理，生活区配床、餐厅、休整区和照明。Macaw's Furniture、Refurbished、Supplementaries、FramedBlocks 负责居住质感——框架方块还能套任意材质。外星居住舱按\"气闸-生存舱-工作舱\"搭建并独立供氧。"
	]
	quest.0D4CAFB9EC9E6AC2.quest_subtitle: "殖民人口与驻军"
	quest.73E35DDDFAD2E809.title: "CFB 厨房网络"
	quest.73E35DDDFAD2E809.quest_desc: [
		"Cooking for Blockheads 的烹饪台是厨房的\"终端\"：它读取所有相连容器的食材并直接出餐。水槽提供水源，冰箱与台面扩充库存，烤炉处理批量加热。把容器用厨房连接器或在同一网络里串起来，再从终端一次出餐。"
	]
	quest.73E35DDDFAD2E809.quest_subtitle: "进度与生存"
	quest.0A70E891FF739F21.title: "应用烹饪与数字厨房"
	quest.0A70E891FF739F21.quest_desc: [
		"Applied Cooking 把厨房挂进 ME 网络：厨房工作站让网络直接调用食材，Applied Delight 的 ME 炊具把农夫乐事锅变成网络设备。配上库存水位与自动合成，食品从\"手动做\"变成\"按需产\"。"
	]
	quest.0A70E891FF739F21.quest_subtitle: "进度与生存"
	quest.46C8EE9AF7A2DC7E.title: "低重力与外星战斗"
	quest.46C8EE9AF7A2DC7E.quest_desc: [
		"外星地表重力低于地球：跳得更高、落得更慢，后坐力会把人推得更远，爆炸物轨迹也不同。接敌前先测试武器手感；对付高速生物优先减速和控制，氧气余量永远是第一指标。"
	]
	quest.46C8EE9AF7A2DC7E.quest_subtitle: "怪潮与防御"
	quest.5FB73CF25E88351B.title: "高级铁路"
	quest.5FB73CF25E88351B.quest_desc: [
		"进阶铁路靠四件事：闭塞信号把线路切成区间，联锁箱保证一区一车；电力机车吃电网不吃燃料；高速轨道配挡停与减速弯；隧道掘进机自动开洞铺轨。规划干线时先定区间，再放信号，最后铺轨。"
	]
	quest.5FB73CF25E88351B.quest_subtitle: "铁路物流"
	quest.2CE7350DEA19BCD0.title: "客户端工具"
	quest.2CE7350DEA19BCD0.quest_desc: [
		"这些模组只影响你自己的客户端，不影响服务器进度：EMI 查配方，Jade 看方块信息，Xaero 地图记路点，Inventory Profiles 整理背包，Mouse Tweaks 拖拽，AppleSkin 看饥饿，Better F3 查坐标，ShulkerBoxTooltip 预览盒内容物，Controlling 查按键冲突。按习惯配置，没有任何一个是进度的门槛。"
	]
	quest.2CE7350DEA19BCD0.quest_subtitle: "进度与生存"
	quest.7768292ADEE8BE72.title: "现代生活"
	quest.7768292ADEE8BE72.quest_desc: [
		"Refurbished 覆盖整套家居：座椅、桌子、沙发、橱柜、灯具与储物。冰箱和抽屉是真实容器，CFB 可以直接读取。"
	]
	quest.7768292ADEE8BE72.quest_subtitle: "殖民人口与驻军"
	quest.3D52D8EF523B1359.title: "家用供电"
	quest.3D52D8EF523B1359.quest_desc: [
		"Refurbished 有自己的电力体系。放置 Energized Furniture 变压器、从电网馈入 FE，即可为附近电器供电。发电机与电脑都挂在这条家庭电网上。"
	]
	quest.3D52D8EF523B1359.quest_subtitle: "能源·石油·网络"
	quest.53235BFFFF0D5717.title: "智能家居"
	quest.53235BFFFF0D5717.quest_desc: [
		"电脑自带 Paddle Ball、Home Control、Marketplace、Coin Miner。Starforge 追加两个应用：Starforge Control 显示基地遥测，Security 显示警报与防御状态。原有功能全部保留。"
	]
	quest.53235BFFFF0D5717.quest_subtitle: "能源·石油·网络"
	quest.0E9D6B40063DF60A.title: "现代厨房"
	quest.0E9D6B40063DF60A.quest_desc: [
		"Refurbished 厨房方块对 CFB 可见：抽屉、冰箱、橱柜是食材容器，水槽与电器是连接器。一张烹饪台读出整个厨房。"
	]
	quest.0E9D6B40063DF60A.quest_subtitle: "进度与生存"
	quest.7AAC1E5061A9C042.title: "工业食品加工"
	quest.7AAC1E5061A9C042.quest_desc: [
		"Engineers Delight 把食品映射到 IE 机器：园艺玻璃罩种植、冲压机绞肉、挤压机榨汁、发酵机酿造。钢制屠宰刀是该层级的门槛。仅做中规模加工，吞吐交给更后期。"
	]
	quest.7AAC1E5061A9C042.quest_subtitle: "进度与生存"
	quest.7B0CAA52B3E70CE4.title: "食品自动化"
	quest.7B0CAA52B3E70CE4.quest_desc: [
		"Immersive Cooking & Farming 提供烹饪锅、发酵罐、食品处理机与烤炉多方块，用于大批量产线。排在 IE 加工之后，产出接入 AE2。"
	]
	quest.7B0CAA52B3E70CE4.quest_subtitle: "进度与生存"
	chapter.13F04EAD5AD7B827.title: "参考手册"
	chapter.13F04EAD5AD7B827.chapter_subtitle: [
		"按主题整理的长教程：进度规则、能源、防御、殖民、岗位、铁路与航天风险。任务描述里的链接会跳到这里。"
	]
}
