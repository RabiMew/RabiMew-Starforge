	]
	quest.1752DF1046FD05B2.quest_subtitle: "推荐阶段：生存时代"
	quest.6A40076FB5A60443.title: "枪械工坊"
	quest.6A40076FB5A60443.quest_desc: [
		"枪械工作台与弹药台落地——守卫与玩家的武器从此走工业化产线，不再靠缴获。"
		""
		"{\"text\":\"» 详见手册：殖民军械\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"15C288AF8333C644\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"殖民军械\"}}"
