	]
	quest.6A40076FB5A60443.quest_subtitle: "推荐阶段：电气时代"
	quest.1AEA18147C0DBE26.title: "武装警卫"
	quest.1AEA18147C0DBE26.quest_desc: [
		"给村庄警卫配发常规枪械（步枪/冲锋枪/霰弹枪），他们是最灵活的机动步兵。高爆与特殊武器留在玩家手里——别让守卫把基地一起炸了。"
		""
		"{\"text\":\"» 详见手册：警卫武器选择\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"725FD622502D6892\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"警卫武器选择\"}}"
