	]
	quest.1AEA18147C0DBE26.quest_subtitle: "推荐阶段：电气时代"
	quest.2F8112B376410105.title: "工业哨戒炮"
	quest.2F8112B376410105.quest_desc: [
		"部署 IE 哨戒炮（枪械炮塔/化学炮塔）：工业时代的中前期固定防御。检查弹药、射界与友军名单，别把所有弹药储备集中在一个炮位。"
		""
		"{\"text\":\"» 详见手册：三层防御\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"482CA592DE6BAB84\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"三层防御\"}}"
	]
	quest.2F8112B376410105.quest_subtitle: "推荐阶段：电气时代"
	quest.605556FAD18F13D3.title: "弹药线"
	quest.605556FAD18F13D3.quest_desc: [
		"弹药箱与制式弹批量下线。枪塔再贵也只是铁疙瘩，弹药才是防线的真正口粮。"
		""
		"{\"text\":\"» 详见手册：弹药后勤\",\"color\":\"aqua\",\"italic\":false,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4C15617E8C8DA7F9\"},\"hoverEvent\":{\"action\":\"show_text\",\"value\":\"弹药后勤\"}}"
	]
