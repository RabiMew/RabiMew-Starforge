	]
	quest.3B95DA0212939412.quest_subtitle: "推荐阶段：太空时代"
	quest.27746B580BF2533A.title: "量子时代"
	quest.27746B580BF2533A.quest_desc: [
		"量子技术打破距离限制。此节点与阶段图谱同步，无需手动完成。"
	]
	quest.27746B580BF2533A.quest_subtitle: "推荐阶段：量子时代"
	chapter.3417920818FE4D66.title: "时代里程碑"
	chapter.3417920818FE4D66.chapter_subtitle: [
		"七个科技时代的进度记录——与 ProgressiveStages 图谱同步，无需手动完成。"
	]
	quest.0E79A6A14CA31F91.title: "欢迎来到星铸"
	quest.0E79A6A14CA31F91.quest_desc: [
		"这本任务书是说明书和里程碑地图：阶段晋级靠制造凭证部件，不依赖提交任务。完成后可随时回到任意章节。"
		""
