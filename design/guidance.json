{
 "schema_version": 1,
 "comment": "Unified runtime guidance: one detection route per real gameplay event, emitted into ProgressiveStages counters / custom advancements / one-time hints. Generated into pack/kubejs/server_scripts/starforge_guidance.js by tools/build-pack.mjs — do not hand-maintain parallel lists in scripts. Detection kinds: craft_item, inventory_item, inventory_tag, inventory_items, block_use (item refs), block_tag (item/block tag resolved at build time), dimension, entity_spawned, quest (polls quest completion via ServerQuestFile), horde_start, horde_end, gun_ns (TaCZ gun NBT namespace), advancement_earned (hooks a vanilla-triggered advancement for its hint).",
 "alien_dimensions": [
  "moon",
  "mars",
  "venus",
  "mercury",
  "glacio",
  "asteroid_belt"
 ],
